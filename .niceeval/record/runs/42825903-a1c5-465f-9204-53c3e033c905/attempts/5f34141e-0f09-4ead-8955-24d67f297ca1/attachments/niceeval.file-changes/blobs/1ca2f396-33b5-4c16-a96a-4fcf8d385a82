use std::collections::BTreeMap;
use std::io::{self, BufWriter, Write};

use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;

const BILLING_INTERVAL_SECONDS: i64 = 15 * 60;

pub struct InvoiceMonthlyCommand;

impl InvoiceMonthlyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let has_date_filter = since.is_some() || until.is_some();
        let entries = if has_date_filter {
            let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
            api_client
                .get_time_entries_filtered_minimal(since, until)
                .await?
        } else {
            api_client.get_entities().await?.time_entries
        };

        let monthly_totals = invoice_monthly_totals(&entries);
        let stdout = io::stdout();
        let mut output = BufWriter::new(stdout);
        write_monthly_invoice(&mut output, &monthly_totals)
            .map_err(|error| Box::new(error) as Box<dyn std::error::Error + Send>)?;
        Ok(())
    }
}

fn invoice_monthly_totals(entries: &[TimeEntry]) -> BTreeMap<String, i64> {
    let mut totals = BTreeMap::new();

    for entry in entries
        .iter()
        .filter(|entry| entry.billable && entry.stop.is_some())
    {
        let seconds = rounded_billable_seconds(entry.duration);
        if seconds == 0 {
            continue;
        }
        let month = entry.start.format("%Y-%m").to_string();
        *totals.entry(month).or_insert(0) += seconds;
    }

    totals
}

fn rounded_billable_seconds(duration: i64) -> i64 {
    if duration <= 0 {
        0
    } else {
        ((duration + BILLING_INTERVAL_SECONDS - 1) / BILLING_INTERVAL_SECONDS)
            * BILLING_INTERVAL_SECONDS
    }
}

fn write_monthly_invoice(
    output: &mut impl Write,
    monthly_totals: &BTreeMap<String, i64>,
) -> io::Result<()> {
    if monthly_totals.is_empty() {
        writeln!(output, "(no data)")?;
        return Ok(());
    }

    let total: i64 = monthly_totals.values().sum();
    for (month, seconds) in monthly_totals {
        writeln!(output, "{month}  {seconds}s")?;
    }
    writeln!(output, "Total  {total}s")?;
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::{TimeZone, Utc};

    fn entry(
        id: i64,
        start: chrono::DateTime<Utc>,
        duration: i64,
        billable: bool,
        stopped: bool,
    ) -> TimeEntry {
        TimeEntry {
            id,
            description: String::new(),
            start,
            stop: stopped.then_some(start + chrono::Duration::seconds(duration)),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_stopped_billable_entries_by_utc_month_and_rounds_each_entry() {
        let entries = vec![
            entry(
                1,
                Utc.with_ymd_and_hms(2026, 2, 28, 23, 59, 0).unwrap(),
                901,
                true,
                true,
            ),
            entry(
                2,
                Utc.with_ymd_and_hms(2026, 1, 1, 0, 0, 0).unwrap(),
                1,
                true,
                true,
            ),
            entry(
                3,
                Utc.with_ymd_and_hms(2026, 2, 1, 0, 0, 0).unwrap(),
                900,
                true,
                true,
            ),
            entry(
                4,
                Utc.with_ymd_and_hms(2026, 2, 1, 0, 0, 0).unwrap(),
                3600,
                false,
                true,
            ),
            entry(
                5,
                Utc.with_ymd_and_hms(2026, 2, 1, 0, 0, 0).unwrap(),
                -1,
                true,
                false,
            ),
        ];

        let totals = invoice_monthly_totals(&entries);
        assert_eq!(
            totals.into_iter().collect::<Vec<_>>(),
            vec![("2026-01".to_string(), 900), ("2026-02".to_string(), 2700),]
        );
    }

    #[test]
    fn writes_empty_and_populated_output() {
        let mut output = Vec::new();
        write_monthly_invoice(&mut output, &BTreeMap::new()).unwrap();
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");

        let totals = BTreeMap::from([("2026-01".to_string(), 900), ("2026-02".to_string(), 2700)]);
        let mut output = Vec::new();
        write_monthly_invoice(&mut output, &totals).unwrap();
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "2026-01  900s\n2026-02  2700s\nTotal  3600s\n"
        );
    }
}
