ONDS)\n}\n\nfn invoice_lines(entries: &[TimeEntry]) -> Vec<InvoiceLine> {\n    let mut totals = HashMap::new();\n\n    for entry in entries\n        .iter()\n        .filter(|entry| entry.billable && !entry.is_running())\n    {\n        let project = entry\n            .project\n            .as_ref()\n            .map(|project| project.name.clone())\n            .unwrap_or_else(|| NO_PROJECT.to_string());\n        *totals.entry(project).or_insert(0) += billable_seconds(entry.duration);\n    }\n\n    let mut lines: Vec<_> = totals\n        .into_iter()\n        .map(|(project, seconds)| InvoiceLine { project, seconds })\n        .collect();\n    lines.sort_by(|left, right| {\n        right\n            .seconds\n            .cmp(&left.seconds)\n            .then_with(|| left.project.cmp(&right.project))\n    });\n    lines\n}\n\nfn format_invoice(lines: &[InvoiceLine]) -> String {\n    if lines.is_empty() {\n        return \"(no data)\\n\".to_string();\n    }\n\n    let mut output = String::new();\n    let total: i64 = lines.iter().map(|line| line.seconds).sum();\n    for line in lines {\n        output.push_str(&format!(\"{}s  {}\\n\", line.seconds, line.project));\n    }\n    output.push_str(&format!(\"{}s  Total\\n\", total));\n    output\n}\n\nimpl InvoiceCommand {\n    pub async fn execute(\n        api_client: impl ApiClient,\n        since: Option<String>,\n        until: Option<String>,\n    ) -> ResultWithDefaultError<()> {\n        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;\n        let entries = api_client.get_time_entries_filtered(since, until).await?;\n        print!(\"{}\", format_invoice(&invoice_lines(&entries)));\n        Ok(())\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::models::Project;\n    use chrono::{TimeZone, Utc};\n\n    fn entry(duration: i64, billable: bool, project: Option<&str>) -> TimeEntry {\n        TimeEntry {\n            duration,\n            billable,\n            project: project.map(|name| Project {\n                id: 1,\n                name: name.to_string(),\n                workspace_id: 1,\n                client: None,\n                is_private: false,\n                active: true,\n                at: Utc.timestamp_opt(0, 0).single().unwrap(),\n                created_at: Utc.timestamp_opt(0, 0).single().unwrap(),\n                color: String::new(),\n                billable: None,\n            }),\n            ..Default::default()\n        }\n    }\n\n    #[test]\n    fn invoices_billable_stopped_entries_with_per_entry_rounding_and_minimum() {\n        let lines = invoice_lines(&[\n            entry(1, true, Some(\"Alpha\")),\n            entry(1_801, true, Some(\"Alpha\")),\n            entry(3_600, true, None),\n            entry(1_200, false, Some(\"Ignored\")),\n            entry(-1, true, Some(\"Running\")),\n        ]);\n\n        assert_eq!(\n            lines,\n            vec![\n                InvoiceLine {\n                    project: \"Alpha\".to_string(),\n                    seconds: 4_500\n                },\n                InvoiceLine {\n                    project: NO_PROJECT.to_string(),\n                    seconds: 3_600\n                },\n            ]\n        );\n    }\n\n    #[test]\n    fn invoice_sorts_equal_totals_alphabetically_and_formats_output() {\n        let lines = invoice_lines(&[\n            entry(1_801, true, Some(\"Zulu\")),\n            entry(1_801, true, Some(\"Alpha\")),\n        ]);\n\n        assert_eq!(\n            format_invoice(&lines),\n            \"2700s  Alpha\\n2700s  Zulu\\n5400s  Total\\n\"\n        );\n    }\n\n    #[test]\n    fn invoice_empty_output_is_no_data() {\n        assert_eq!(format_invoice(&[]), \"(no data)\\n\");\n    }\n}\n","exit_code":0,"status":"completed"}}
