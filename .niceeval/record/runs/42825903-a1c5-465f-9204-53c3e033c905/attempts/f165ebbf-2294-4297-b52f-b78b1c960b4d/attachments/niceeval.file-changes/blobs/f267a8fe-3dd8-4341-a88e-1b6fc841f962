use crate::api::client::ApiClient;
use crate::constants;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde::Serialize;
use std::collections::HashMap;

const BILLING_UNIT_SECONDS: i64 = 15 * 60;

pub struct BillCommand;

#[derive(Debug, PartialEq, Eq)]
struct ProjectTotal {
    name: String,
    seconds: i64,
}

#[derive(Serialize)]
struct BillSummary {
    projects: Vec<BillProject>,
    total_billable_seconds: i64,
}

#[derive(Serialize)]
struct BillProject {
    project: String,
    billable_seconds: i64,
}

fn project_totals(entries: Vec<TimeEntry>) -> Vec<ProjectTotal> {
    let mut totals: HashMap<Option<i64>, ProjectTotal> = HashMap::new();

    for entry in entries
        .into_iter()
        .filter(|entry| entry.billable && entry.stop.is_some() && entry.duration > 0)
    {
        let rounded_seconds = ((entry.duration + BILLING_UNIT_SECONDS - 1) / BILLING_UNIT_SECONDS)
            * BILLING_UNIT_SECONDS;
        let key = entry.project.as_ref().map(|project| project.id);
        let name = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| constants::NO_PROJECT.to_string());

        totals
            .entry(key)
            .and_modify(|total| total.seconds += rounded_seconds)
            .or_insert(ProjectTotal {
                name,
                seconds: rounded_seconds,
            });
    }

    let mut totals: Vec<_> = totals.into_values().collect();
    totals.sort_by(|left, right| {
        right
            .seconds
            .cmp(&left.seconds)
            .then_with(|| left.name.cmp(&right.name))
    });
    totals
}

fn bill_summary(totals: Vec<ProjectTotal>) -> BillSummary {
    let total_billable_seconds = totals.iter().map(|total| total.seconds).sum();
    let projects = totals
        .into_iter()
        .map(|total| BillProject {
            project: total.name,
            billable_seconds: total.seconds,
        })
        .collect();

    BillSummary {
        projects,
        total_billable_seconds,
    }
}

impl BillCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let totals = project_totals(api_client.get_time_entries_filtered(since, until).await?);

        if json {
            let json = serde_json::to_string(&bill_summary(totals))
                .expect("failed to serialize billing summary");
            println!("{json}");
        } else if totals.is_empty() {
            println!("(no data)");
        } else {
            let total_seconds: i64 = totals.iter().map(|total| total.seconds).sum();
            for total in totals {
                println!("{}s  {}", total.seconds, total.name);
            }
            println!("{total_seconds}s  Total");
        }

        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::models::Project;
    use chrono::{TimeZone, Utc};

    fn entry(
        duration: i64,
        billable: bool,
        stopped: bool,
        project: Option<(i64, &str)>,
    ) -> TimeEntry {
        TimeEntry {
            id: duration,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).single().unwrap(),
            stop: stopped.then(|| Utc.timestamp_opt(duration, 0).single().unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: project.map(|(id, name)| Project {
                id,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).single().unwrap(),
                created_at: Utc.timestamp_opt(0, 0).single().unwrap(),
                color: String::new(),
                billable: None,
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn totals_round_each_billable_stopped_entry_and_sort_results() {
        let totals = project_totals(vec![
            entry(420, true, true, Some((1, "Beta"))),
            entry(1320, true, true, Some((1, "Beta"))),
            entry(900, true, true, Some((2, "Alpha"))),
            entry(1, false, true, Some((3, "Ignored"))),
            entry(1, true, false, Some((4, "Running"))),
            entry(60, true, true, None),
        ]);

        assert_eq!(
            totals,
            vec![
                ProjectTotal {
                    name: "Beta".to_string(),
                    seconds: 2700
                },
                ProjectTotal {
                    name: "Alpha".to_string(),
                    seconds: 900
                },
                ProjectTotal {
                    name: "No Project".to_string(),
                    seconds: 900
                },
            ]
        );
    }

    #[test]
    fn equal_totals_are_sorted_alphabetically() {
        let totals = project_totals(vec![
            entry(1, true, true, Some((1, "Zeta"))),
            entry(1, true, true, Some((2, "Alpha"))),
        ]);

        assert_eq!(totals[0].name, "Alpha");
        assert_eq!(totals[1].name, "Zeta");
    }

    #[test]
    fn json_summary_preserves_project_order_and_empty_results() {
        let summary = bill_summary(project_totals(vec![
            entry(1, true, true, Some((1, "Beta"))),
            entry(1800, true, true, Some((2, "Alpha"))),
        ]));
        assert_eq!(
            serde_json::to_string(&summary).unwrap(),
            r#"{"projects":[{"project":"Alpha","billable_seconds":1800},{"project":"Beta","billable_seconds":900}],"total_billable_seconds":2700}"#
        );
        assert_eq!(
            serde_json::to_string(&bill_summary(vec![])).unwrap(),
            r#"{"projects":[],"total_billable_seconds":0}"#
        );
    }
}
