form/commit/645478be493ee2d992275db6bf7bb98d64de459b.patch'\"}","io.output":"{\"output\":\"From 645478be493ee2d992275db6bf7bb98d64de459b Mon Sep 17 00:00:00 2001\\nFrom: Copilot <198982749+Copilot@users.noreply.github.com>\\nDate: Sun, 24 May 2026 16:18:28 +1000\\nSubject: [PATCH] =?UTF-8?q?=F0=9F=90=9E=20fix=20FieldArray=20errors=20over?=\\n =?UTF-8?q?riding=20nested=20fields=20(#13476)?=\\nMIME-Version: 1.0\\nContent-Type: text/plain; charset=UTF-8\\nContent-Transfer-Encoding: 8bit\\n\\n* Initial plan\\n\\n* fix: preserve nested field array errors when root error and trigger coexist\\n\\nWhen a resolver returns mixed errors (both root-level and nested indexed\\nerrors) for a field array, calling trigger() alongside a field array action\\n(like remove()) could cause nested field errors to be wiped out.\\n\\nRoot cause: executeSchemaAndUpdateState() was calling updateFieldArrayRootError()\\nfor all plain-object field array errors. updateFieldArrayRootError() used\\nconvertToArrayPayload() to coerce the existing errors, but when those errors\\nwere already a plain object (set by the useFieldArray useEffect), this wrapped\\nthe entire plain object as index 0 of an array — causing all the\\ncorrectly-indexed nested errors to become inaccessible.\\n\\nFix 1 (createFormControl.ts): Only call updateFieldArrayRootError() for\\nfield array errors that are root-only plain objects (no numeric/index keys).\\nWhen the error has numeric keys (mixed root + nested), set it directly so\\nboth root info (via .type/.message) and nested errors (via [i]) are preserved.\\n\\nFix 2 (updateFieldArrayRootError.ts): Replace convertToArrayPayload() with\\nan Array.isArray() check so that non-array existing errors are not wrapped.\\nThis prevents a scenario where a second trigger() with a root-only error\\nwraps a previously-set plain object, losing its nested entries.\\n\\n* update lint\\n\\n---------\\n\\nCo-authored-by: copilot-swe-agent[bot] <198982749+Copilot@users.noreply.github.com>\\nCo-authored-by: bill <bluebill1049@hotmail.com>\\n---\\n src/__tests__/useFieldArray.test.tsx   | 115 +++++++++++++++++++++++++\\n src/logic/createFormControl.ts         |   4 +-\\n src/logic/updateFieldArrayRootError.ts |   4 +-\\n 3 files changed, 120 insertions(+), 3 deletions(-)\\n\\ndiff --git a/src/__tests__/useFieldArray.test.tsx b/src/__tests__/useFieldArray.test.tsx\\nindex c2d2f19c227..750c7a7081a 100644\\n--- a/src/__tests__/useFieldArray.test.tsx\\n+++ b/src/__tests__/useFieldArray.test.tsx\\n@@ -754,6 +754,121 @@ describe('useFieldArray', () => {\\n         ).toBeInTheDocument();\\n       });\\n     });\\n+\\n+    it('should preserve nested field errors after remove when both root and field errors exist', async () => {\\n+      type FormValues = {\\n+        test: { value: string }[];\\n+      };\\n+\\n+      const App = () => {\\n+        const {\\n+          register,\\n+          control,\\n+          trigger,\\n+          formState: { errors },\\n+        } = useForm<FormValues>({\\n+          mode: 'onChange',\\n+          resolver: async (data): Promise<ResolverResult<FormValues>> => {\\n+            const fieldErrors: { test?: any } = {};\\n+            if (data.test.length < 4) {\\n+              fieldErrors.test = {\\n+                type: 'min',\\n+                message: 'Needs at least 4 items',\\n+              };\\n+            }\\n+            for (const [index, item] of data.test.entries()) {\\n+              if (item.value.length < 3) {\\n+                fieldErrors.test = fieldErrors.test || [];\\n+                fieldErrors.test[index] = {\\n+                  value: {\\n+                    type: 'minLength',\\n+                    message: `Item ${index} too short`,\\n+                  },\\n+                };\\n+              }\\n+            }\\n+            return Object.keys(fieldErrors).length\\n+              ? { values: {}, errors: fieldErrors }\\n+              : { values: data, errors: {} };\\n+          },\\n+          defaultValues: {\\n+            // Start with 3 items (min(4) fails) and item 2 has a short value\\n+            test: [{ value: 'hello' }, { value: 'goodbye' }, { value: …(+4362)","io.status":"completed"},"kind":"tool"},{"traceId":"b5e15868579bbb25f2f0ad7c104ef090","spanId":"1f3b7e9ccc572849","name":"handle_tool_call_with_source","startMs":1787285344172,"endMs":1787285344704,"status":"unset","attributes":{"code.file.path":"core/src/tools/parallel.rs","code.module.name":"codex_core::tools::parallel","code.line.number":93,"thread.id":16,"thread.name":"tokio-rt-worker","target":"codex_core::tools::parallel","busy_ns":31819,"idle_ns":532436533,"gen_ai.operation.name":"execute_tool"},"kind":"tool"},{"traceId":"4be4e7427c743f45e3f96879a52d95a9","spanId":"08b6ade70c1b34d1","parentSpanId":"a3c5dd4cd3644252","name":"run_sampling_request","startMs":1787285344708,"endMs":1787285355515,"status":"unset","attributes":{"code.file.path":"core/src/session/turn.rs","code.module.name":"codex_core::session::turn","code.line.number":1104,"thread.id":12,"thread.name":"tokio-rt-worker","target":"codex_core::session::turn","turn_id":"01a02280-b06e-7b02-900c-77653dee04ff","model":"gpt-5.6-luna","cwd":"/home/sandbox/workspace","busy_ns":34375108,"idle_ns":10772286860,"gen_ai.operation.name":"chat"},"kind":"model"},{"traceId":"4be4e7427c743f45e3f96879a52d95a9","spanId":"bb7d7774964e911e","parentSpanId":"471f944f96ab5105","name":"model_client.stream_responses_api","startMs":1787285344709,"endMs":1787285348399,"status":"unset","attributes":{"code.file.path":"core/src/client.rs","code.module.name":"codex_core::client","code.line.number":1383,"thread.id":12,"thread.name":"tokio-rt-worker","target":"codex_core::client","model":"gpt-5.6-luna","wire_api":"responses","transport":"responses_http","http.method":"POST","api.path":"responses","turn.has_metadata_header":true,"busy_ns":14453575,"idle_ns":3675780240,"gen_ai.operation.name":"chat"},"kind":"model"},{"traceId":"4be4e7427c743f45e3f96879a52d9