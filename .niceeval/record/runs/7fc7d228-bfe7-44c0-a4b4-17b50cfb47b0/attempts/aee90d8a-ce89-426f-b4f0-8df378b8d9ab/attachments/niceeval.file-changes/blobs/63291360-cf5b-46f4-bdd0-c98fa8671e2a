use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use chrono::{Datelike, NaiveDate};
use serde::Serialize;
use std::collections::BTreeMap;
use std::io::{self, Write};

const BILLING_UNIT_SECONDS: i64 = 15 * 60;
const BILLING_MINIMUM_SECONDS: i64 = 30 * 60;

pub struct BillWeeklyCommand;

#[derive(Serialize)]
struct WeeklyBillingOutput {
    weeks: Vec<WeeklyBillingWeek>,
    total_billable_seconds: i64,
}

#[derive(Serialize)]
struct WeeklyBillingWeek {
    week: String,
    billable_seconds: i64,
}

/// Apply the per-entry billing rule before entries are grouped.
pub fn billable_seconds(entry: &TimeEntry) -> Option<i64> {
    if !entry.billable || entry.stop.is_none() {
        return None;
    }

    let rounded = entry
        .duration
        .max(0)
        .saturating_add(BILLING_UNIT_SECONDS - 1)
        / BILLING_UNIT_SECONDS
        * BILLING_UNIT_SECONDS;
    Some(rounded.max(BILLING_MINIMUM_SECONDS))
}

pub fn weekly_totals(entries: &[TimeEntry]) -> BTreeMap<NaiveDate, i64> {
    entries
        .iter()
        .filter_map(|entry| {
            billable_seconds(entry).map(|seconds| {
                let start = entry.start.date_naive();
                let monday =
                    start - chrono::Duration::days(start.weekday().num_days_from_monday() as i64);
                (monday, seconds)
            })
        })
        .fold(BTreeMap::new(), |mut totals, (monday, seconds)| {
            *totals.entry(monday).or_default() += seconds;
            totals
        })
}

fn weekly_json(totals: &BTreeMap<NaiveDate, i64>) -> String {
    let weeks = totals
        .iter()
        .map(|(week, seconds)| WeeklyBillingWeek {
            week: week.format("%Y-%m-%d").to_string(),
            billable_seconds: *seconds,
        })
        .collect::<Vec<_>>();
    let total_billable_seconds = totals.values().sum();
    serde_json::to_string(&WeeklyBillingOutput {
        weeks,
        total_billable_seconds,
    })
    .expect("failed to serialize weekly billing output")
}

impl BillWeeklyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client
            .get_time_entries_filtered_minimal(since, until)
            .await?;
        let totals = weekly_totals(&entries);
        let total: i64 = totals.values().sum();
        let stdout = io::stdout();
        let mut output = stdout.lock();

        if json {
            writeln!(output, "{}", weekly_json(&totals)).expect("failed to print");
        } else if totals.is_empty() {
            writeln!(output, "(no data)").expect("failed to print");
        } else {
            for (monday, seconds) in totals {
                writeln!(output, "{}  {seconds}s", monday.format("%Y-%m-%d"))
                    .expect("failed to print");
            }
            writeln!(output, "Total  {total}s").expect("failed to print");
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::{TimeZone, Utc};

    fn entry(start: &str, duration: i64, billable: bool, stop: bool) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.datetime_from_str(start, "%Y-%m-%dT%H:%M:%SZ").unwrap(),
            stop: stop.then_some(Utc::now()),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn bills_each_entry_with_rounding_and_minimum_before_grouping() {
        let totals = weekly_totals(&[
            entry("2026-01-05T09:00:00Z", 1, true, true),
            entry("2026-01-06T09:00:00Z", 901, true, true),
            entry("2026-01-11T09:00:00Z", 3600, true, true),
        ]);

        assert_eq!(totals[&NaiveDate::from_ymd_opt(2026, 1, 5).unwrap()], 7_200);
    }

    #[test]
    fn excludes_non_billable_and_running_entries_and_uses_utc_start() {
        let totals = weekly_totals(&[
            entry("2026-01-11T23:30:00Z", 3600, true, true),
            entry("2026-01-12T00:30:00Z", 3600, true, true),
            entry("2026-01-12T09:00:00Z", 3600, false, true),
            entry("2026-01-12T09:00:00Z", 3600, true, false),
        ]);

        assert_eq!(totals.len(), 2);
        assert_eq!(totals[&NaiveDate::from_ymd_opt(2026, 1, 5).unwrap()], 3600);
        assert_eq!(totals[&NaiveDate::from_ymd_opt(2026, 1, 12).unwrap()], 3600);
    }

    #[test]
    fn json_output_is_sorted_and_has_integer_totals() {
        let totals = weekly_totals(&[
            entry("2026-03-09T09:00:00Z", 1800, true, true),
            entry("2026-03-02T09:00:00Z", 900, true, true),
        ]);

        assert_eq!(
            weekly_json(&totals),
            r#"{"weeks":[{"week":"2026-03-02","billable_seconds":1800},{"week":"2026-03-09","billable_seconds":1800}],"total_billable_seconds":3600}"#
        );
    }

    #[test]
    fn empty_json_output_has_empty_weeks_and_zero_total() {
        assert_eq!(
            weekly_json(&BTreeMap::new()),
            r#"{"weeks":[],"total_billable_seconds":0}"#
        );
    }
}
