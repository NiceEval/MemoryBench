use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

use crate::api::client::ApiClient;
use crate::constants;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;

const BILLING_UNIT_SECONDS: i64 = 15 * 60;

pub struct BillCommand;

impl BillCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let rows = aggregate_entries(&entries);
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);

        if rows.is_empty() {
            writeln!(handle, "(no data)").expect("failed to print");
            return Ok(());
        }

        let total: i64 = rows.iter().map(|(_, seconds)| seconds).sum();
        for (project, seconds) in rows {
            writeln!(handle, "{seconds}s  {project}").expect("failed to print");
        }
        writeln!(handle, "{total}s  Total").expect("failed to print");
        Ok(())
    }
}

fn aggregate_entries(entries: &[TimeEntry]) -> Vec<(String, i64)> {
    let mut totals: HashMap<String, i64> = HashMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() || entry.duration <= 0 {
            continue;
        }

        let rounded_seconds = ((entry.duration + BILLING_UNIT_SECONDS - 1) / BILLING_UNIT_SECONDS)
            * BILLING_UNIT_SECONDS;
        let project = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| constants::NO_PROJECT.to_string());
        *totals.entry(project).or_default() += rounded_seconds;
    }

    let mut rows: Vec<_> = totals.into_iter().collect();
    rows.sort_by(|(name_a, seconds_a), (name_b, seconds_b)| {
        seconds_b.cmp(seconds_a).then_with(|| name_a.cmp(name_b))
    });
    rows
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::{TimeZone, Utc};

    fn entry(duration: i64, billable: bool, stop: bool, project: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: duration,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).unwrap(),
            stop: stop.then(|| Utc.timestamp_opt(duration, 0).unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: project.map(|name| crate::models::Project {
                id: 1,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).unwrap(),
                created_at: Utc.timestamp_opt(0, 0).unwrap(),
                color: String::new(),
                billable: None,
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn filters_and_rounds_each_entry_before_sorting() {
        let entries = vec![
            entry(7 * 60, true, true, Some("Beta")),
            entry(22 * 60, true, true, Some("Beta")),
            entry(15 * 60, true, true, Some("Alpha")),
            entry(1, true, true, None),
            entry(60 * 60, false, true, Some("Ignored")),
            entry(60 * 60, true, false, Some("Running")),
        ];

        assert_eq!(
            aggregate_entries(&entries),
            vec![
                ("Beta".to_string(), 45 * 60),
                ("Alpha".to_string(), 15 * 60),
                (constants::NO_PROJECT.to_string(), 15 * 60),
            ]
        );
    }

    #[test]
    fn ties_are_sorted_alphabetically() {
        let entries = vec![
            entry(15 * 60, true, true, Some("Zulu")),
            entry(15 * 60, true, true, Some("Alpha")),
        ];

        assert_eq!(
            aggregate_entries(&entries),
            vec![
                ("Alpha".to_string(), 15 * 60),
                ("Zulu".to_string(), 15 * 60)
            ]
        );
    }
}
