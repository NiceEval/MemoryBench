use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

const ROUNDING_INCREMENT_SECONDS: i64 = 15 * 60;
const MINIMUM_ENTRY_SECONDS: i64 = 30 * 60;
const NO_PROJECT: &str = "No Project";

pub struct InvoiceCommand;

impl InvoiceCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let summary = summarize(&entries);

        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);
        write_summary(&mut handle, &summary).expect("failed to print");
        Ok(())
    }
}

fn summarize(entries: &[TimeEntry]) -> Vec<(String, i64)> {
    let mut projects: HashMap<String, i64> = HashMap::new();

    for entry in entries {
        if !entry.billable || entry.is_running() {
            continue;
        }

        let project = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| NO_PROJECT.to_string());
        let seconds = round_invoice_duration(entry.duration);
        *projects.entry(project).or_default() += seconds;
    }

    let mut summary: Vec<_> = projects.into_iter().collect();
    summary.sort_by(|(left_name, left_seconds), (right_name, right_seconds)| {
        right_seconds
            .cmp(left_seconds)
            .then_with(|| left_name.cmp(right_name))
    });
    summary
}

fn round_invoice_duration(seconds: i64) -> i64 {
    let rounded = ((seconds + ROUNDING_INCREMENT_SECONDS - 1) / ROUNDING_INCREMENT_SECONDS)
        * ROUNDING_INCREMENT_SECONDS;
    rounded.max(MINIMUM_ENTRY_SECONDS)
}

fn write_summary(handle: &mut impl Write, summary: &[(String, i64)]) -> std::io::Result<()> {
    if summary.is_empty() {
        writeln!(handle, "(no data)")?;
        return Ok(());
    }

    let total: i64 = summary.iter().map(|(_, seconds)| seconds).sum();
    for (project, seconds) in summary {
        writeln!(handle, "{seconds}s  {project}")?;
    }
    writeln!(handle, "{total}s  Total")
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::api::client::MockApiClient;
    use crate::models::{Project, TimeEntry};
    use chrono::{TimeZone, Utc};

    fn entry(duration: i64, billable: bool, running: bool, project: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).unwrap(),
            stop: (!running).then(|| Utc.timestamp_opt(duration, 0).unwrap()),
            duration: if running { -1 } else { duration },
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: project.map(|name| Project {
                id: 1,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).unwrap(),
                created_at: Utc.timestamp_opt(0, 0).unwrap(),
                color: String::new(),
                billable: None,
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn summary_rounds_and_applies_minimum_per_entry() {
        let summary = summarize(&[
            entry(1, true, false, Some("Alpha")),
            entry(901, true, false, Some("Alpha")),
            entry(1_801, true, false, Some("Beta")),
            entry(3_600, false, false, Some("Ignored")),
            entry(3_600, true, true, Some("Ignored")),
            entry(1_800, true, false, None),
        ]);

        assert_eq!(
            summary,
            vec![
                ("Alpha".to_string(), 3_600),
                ("Beta".to_string(), 2_700),
                ("No Project".to_string(), 1_800),
            ]
        );
    }

    #[test]
    fn summary_sorts_equal_totals_alphabetically() {
        let summary = summarize(&[
            entry(1_800, true, false, Some("Zebra")),
            entry(1_800, true, false, Some("Alpha")),
        ]);

        assert_eq!(
            summary,
            vec![("Alpha".to_string(), 1_800), ("Zebra".to_string(), 1_800)]
        );
    }

    #[test]
    fn empty_summary_prints_no_data() {
        let mut output = Vec::new();
        write_summary(&mut output, &[]).unwrap();
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");
    }

    #[test]
    fn summary_prints_projects_and_total() {
        let mut output = Vec::new();
        write_summary(
            &mut output,
            &[
                ("Alpha".to_string(), 4_500),
                ("No Project".to_string(), 1_800),
            ],
        )
        .unwrap();
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "4500s  Alpha\n1800s  No Project\n6300s  Total\n"
        );
    }

    #[tokio::test]
    async fn execute_normalizes_date_filters_before_fetching_entries() {
        let (expected_since, expected_until) = crate::utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .unwrap();
        let mut api_client = MockApiClient::new();
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected_since && *until == expected_until)
            .returning(|_, _| Ok(Vec::new()));

        InvoiceCommand::execute(
            api_client,
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .await
        .unwrap();
    }
}
