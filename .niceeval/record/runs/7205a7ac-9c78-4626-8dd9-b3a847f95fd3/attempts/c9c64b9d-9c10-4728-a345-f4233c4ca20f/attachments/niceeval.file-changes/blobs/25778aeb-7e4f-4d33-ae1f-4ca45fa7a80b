/**
 * Shared document event delegation.
 *
 * Instead of N tooltips each calling document.addEventListener(type, handler),
 * we maintain ONE document listener per event type and propagation phase. When the event fires,
 * we iterate through all registered handlers for that type.
 *
 * This reduces document-level listeners from O(N × eventTypes) to O(eventTypes).
 */

type Handler = (event: Event) => void

type EventPhase = 'capture' | 'bubble'

interface DelegatedEventHandlers {
  capture: Set<Handler>
  bubble: Set<Handler>
}

const handlersByType = new Map<string, DelegatedEventHandlers>()

function getOrCreateHandlers(eventType: string): DelegatedEventHandlers {
  let handlers = handlersByType.get(eventType)
  if (!handlers) {
    handlers = {
      capture: new Set(),
      bubble: new Set(),
    }
    handlersByType.set(eventType, handlers)
  }
  return handlers
}

function dispatch(event: Event, phase: EventPhase): void {
  const handlers = handlersByType.get(event.type)?.[phase]
  if (handlers) {
    // Safe to iterate directly — mutations (add/remove) only happen in
    // setup/cleanup, not during dispatch. Set iteration is stable for
    // entries that existed when iteration began.
    handlers.forEach((handler) => {
      handler(event)
    })
  }
}

function dispatchCapture(event: Event): void {
  dispatch(event, 'capture')
}

function dispatchBubble(event: Event): void {
  dispatch(event, 'bubble')
}

function addPhaseListener(eventType: string, phase: EventPhase): void {
  document.addEventListener(eventType, phase === 'capture' ? dispatchCapture : dispatchBubble, {
    capture: phase === 'capture',
  })
}

function removePhaseListener(eventType: string, phase: EventPhase): void {
  document.removeEventListener(eventType, phase === 'capture' ? dispatchCapture : dispatchBubble, {
    capture: phase === 'capture',
  })
}

/**
 * Register a handler for a document-level event type.
 * Returns an unsubscribe function.
 */
export function addDelegatedEventListener(
  eventType: string,
  handler: Handler,
  capture = false,
): () => void {
  const handlers = getOrCreateHandlers(eventType)
  const phase = capture ? 'capture' : 'bubble'
  const set = handlers[phase]
  if (set.size === 0) {
    addPhaseListener(eventType, phase)
  }
  set.add(handler)

  return () => {
    set.delete(handler)
    if (set.size === 0) {
      removePhaseListener(eventType, phase)
    }
    if (handlers.capture.size === 0 && handlers.bubble.size === 0) {
      handlersByType.delete(eventType)
    }
  }
}

/**
 * Reset for testing purposes.
 */
export function resetEventDelegation(): void {
  handlersByType.forEach((_handlers, eventType) => {
    removePhaseListener(eventType, 'capture')
    removePhaseListener(eventType, 'bubble')
  })
  handlersByType.clear()
}
