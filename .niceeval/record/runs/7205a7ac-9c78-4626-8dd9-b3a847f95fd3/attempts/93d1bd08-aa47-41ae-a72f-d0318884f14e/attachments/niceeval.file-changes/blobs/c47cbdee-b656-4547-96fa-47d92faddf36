import { flatten } from '../../utils/flatten';

describe('flatten', () => {
  it('should flatten form values into flat form data', () => {
    expect(
      flatten({
        hey: 'test',
        array: [
          {
            test: '1',
            test2: '2',
            test3: null,
          },
        ],
        test: {
          nested: {
            test: 'bill',
            test3: null,
          },
        },
        test1: null,
      }),
    ).toMatchSnapshot();
  });

  it('should preserve Date objects as leaf values', () => {
    const createdAt = new Date('2024-01-01');
    const start = new Date('2024-02-01');
    const end = new Date('2024-02-02');

    const result = flatten({
      name: 'Alice',
      createdAt,
      age: 30,
      range: { start, end },
    });

    expect(result).toEqual({
      name: 'Alice',
      createdAt,
      age: 30,
      'range.start': start,
      'range.end': end,
    });
    expect(result.createdAt).toBe(createdAt);
    expect(result['range.start']).toBe(start);
    expect(result['range.end']).toBe(end);
  });
});
