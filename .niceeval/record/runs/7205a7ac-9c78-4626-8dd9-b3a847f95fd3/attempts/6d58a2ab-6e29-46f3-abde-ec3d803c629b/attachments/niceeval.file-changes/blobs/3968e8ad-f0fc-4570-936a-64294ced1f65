import * as React from "react";
import { act, render, screen } from "@testing-library/react";

import { lightbox, expectLightboxToBeOpen, querySelector } from "../test-utils.js";
import { GenericSlide, ZoomRef } from "../../../src/index.js";
import { Zoom } from "../../../src/plugins/index.js";

declare module "../../../src/types.js" {
  interface SlideTypes {
    custom: CustomSlide;
  }
}

interface CustomSlide extends GenericSlide {
  type: "custom";
}

describe("Zoom", () => {
  it("renders without crashing", async () => {
    render(
      lightbox({
        slides: Array.from({ length: 3 }).map((_, i) => ({
          src: `image${i + 1}`,
          width: 3000,
          height: 2000,
        })),
        plugins: [Zoom],
      }),
    );

    act(() => {
      screen.getByLabelText("Zoom in").click();
    });

    act(() => {
      screen.getByLabelText("Zoom out").click();
    });

    expectLightboxToBeOpen();
  });

  it.each([
    [undefined, 8],
    [4, 4],
    [() => undefined, 8],
    [() => 6, 6],
  ])("zooms supported custom slides up to %s", (maxZoom, expectedMaxZoom) => {
    const zoomRef = React.createRef<ZoomRef>();

    render(
      lightbox({
        slides: [{ type: "custom" }],
        plugins: [Zoom],
        zoom: { ref: zoomRef, supports: ["custom"], maxZoom },
        render: { slide: () => React.createElement("div", { "data-testid": "custom-slide" }) },
      }),
    );

    expect(
      querySelector(".yarl__slide_current [data-testid='custom-slide']")?.closest(".yarl__slide_wrapper"),
    ).toBeInTheDocument();
    expect(zoomRef.current).toMatchObject({ disabled: false, maxZoom: expectedMaxZoom, zoom: 1 });

    act(() => {
      screen.getByLabelText("Zoom in").click();
    });

    expect(zoomRef.current?.zoom).toBe(2);
  });

  it("leaves unsupported custom slides unwrapped", () => {
    const zoomRef = React.createRef<ZoomRef>();

    render(
      lightbox({
        slides: [{ type: "custom" }],
        plugins: [Zoom],
        zoom: { ref: zoomRef },
        render: { slide: () => React.createElement("div", { "data-testid": "custom-slide" }) },
      }),
    );

    expect(
      querySelector(".yarl__slide_current [data-testid='custom-slide']")?.closest(".yarl__slide_wrapper"),
    ).not.toBeInTheDocument();
    expect(zoomRef.current?.disabled).toBe(true);
  });
});
