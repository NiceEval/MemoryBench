use std::collections::BTreeMap;
use std::io::{self, BufWriter, Write};

use chrono::Datelike;

use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;

const ROUNDING_INCREMENT_SECONDS: i64 = 15 * 60;
const MINIMUM_BILLABLE_SECONDS: i64 = 30 * 60;

pub struct InvoiceMonthlyCommand;

impl InvoiceMonthlyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client
            .get_time_entries_filtered_minimal(since, until)
            .await?;
        let summary = summarize(&entries);
        let stdout = io::stdout();
        write_summary(&mut BufWriter::new(stdout), &summary)
            .map_err(|error| Box::new(error) as Box<dyn std::error::Error + Send>)
    }
}

fn summarize(entries: &[TimeEntry]) -> BTreeMap<String, i64> {
    let mut months = BTreeMap::new();

    for entry in entries
        .iter()
        .filter(|entry| entry.billable && entry.stop.is_some())
    {
        let month = format!("{:04}-{:02}", entry.start.year(), entry.start.month());
        *months.entry(month).or_insert(0) += billable_seconds(entry.duration);
    }

    months
}

fn billable_seconds(duration: i64) -> i64 {
    let rounded = duration
        .max(0)
        .saturating_add(ROUNDING_INCREMENT_SECONDS - 1)
        / ROUNDING_INCREMENT_SECONDS
        * ROUNDING_INCREMENT_SECONDS;
    rounded.max(MINIMUM_BILLABLE_SECONDS)
}

fn write_summary(mut writer: impl Write, months: &BTreeMap<String, i64>) -> io::Result<()> {
    if months.is_empty() {
        writeln!(writer, "(no data)")?;
        return Ok(());
    }

    let total: i64 = months.values().sum();
    for (month, seconds) in months {
        writeln!(writer, "{month}  {seconds}s")?;
    }
    writeln!(writer, "Total  {total}s")?;
    Ok(())
}

#[cfg(test)]
mod tests {
    use chrono::{TimeZone, Utc};

    use super::{summarize, write_summary};
    use crate::models::TimeEntry;

    fn entry(id: i64, start: &str, duration: i64, billable: bool, stopped: bool) -> TimeEntry {
        TimeEntry {
            id,
            description: String::new(),
            start: Utc.datetime_from_str(start, "%Y-%m-%dT%H:%M:%SZ").unwrap(),
            stop: stopped.then(|| Utc.timestamp_opt(0, 0).single().unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_eligible_entries_by_utc_month_with_per_entry_invoice_rules() {
        let entries = vec![
            entry(1, "2026-02-01T00:00:00Z", 901, true, true),
            entry(2, "2026-01-31T23:59:59Z", 60, true, true),
            entry(3, "2026-01-01T00:00:00Z", 1801, true, true),
            entry(4, "2026-02-01T00:00:00Z", 3600, false, true),
            entry(5, "2026-02-01T00:00:00Z", 3600, true, false),
        ];

        let summary = summarize(&entries);
        assert_eq!(summary.get("2026-01"), Some(&4500));
        assert_eq!(summary.get("2026-02"), Some(&1800));

        let mut output = Vec::new();
        write_summary(&mut output, &summary).unwrap();
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "2026-01  4500s\n2026-02  1800s\nTotal  6300s\n"
        );
    }

    #[test]
    fn writes_no_data_for_no_eligible_entries() {
        let summary = summarize(&[entry(1, "2026-01-01T00:00:00Z", 3600, false, true)]);
        let mut output = Vec::new();
        write_summary(&mut output, &summary).unwrap();
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");
    }
}
