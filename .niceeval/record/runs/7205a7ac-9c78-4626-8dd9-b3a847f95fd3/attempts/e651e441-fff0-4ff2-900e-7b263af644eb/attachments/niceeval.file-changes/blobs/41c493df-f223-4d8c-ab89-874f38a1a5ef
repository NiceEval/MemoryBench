use std::{
    collections::BTreeMap,
    io::{self, BufWriter, Write},
};

use chrono::{Datelike, NaiveDate};

use crate::{
    api::client::ApiClient,
    models::{ResultWithDefaultError, TimeEntry},
    utilities,
};

const BILLING_INCREMENT_SECONDS: i64 = 15 * 60;

pub struct BillWeeklyCommand;

impl BillWeeklyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client
            .get_time_entries_filtered_minimal(since, until)
            .await?;
        let weeks = billable_seconds_by_week(&entries);

        let stdout = io::stdout();
        let mut output = BufWriter::new(stdout.lock());
        write!(output, "{}", format_billable_weeks(&weeks)).expect("failed to print");
        Ok(())
    }
}

fn billable_seconds_by_week(entries: &[TimeEntry]) -> BTreeMap<NaiveDate, i64> {
    let mut weeks = BTreeMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() {
            continue;
        }

        let start_date = entry.start.date_naive();
        let monday =
            start_date - chrono::Duration::days(start_date.weekday().num_days_from_monday() as i64);
        *weeks.entry(monday).or_insert(0) += rounded_billable_seconds(entry.duration);
    }

    weeks
}

fn rounded_billable_seconds(duration: i64) -> i64 {
    if duration <= 0 {
        return 0;
    }

    let whole_increments = duration / BILLING_INCREMENT_SECONDS;
    if duration % BILLING_INCREMENT_SECONDS == 0 {
        whole_increments * BILLING_INCREMENT_SECONDS
    } else {
        (whole_increments + 1) * BILLING_INCREMENT_SECONDS
    }
}

fn format_billable_weeks(weeks: &BTreeMap<NaiveDate, i64>) -> String {
    if weeks.is_empty() {
        return "(no data)\n".to_string();
    }

    let mut output = String::new();
    let total: i64 = weeks.values().sum();
    for (monday, seconds) in weeks {
        output.push_str(&format!("{monday}  {seconds}s\n"));
    }
    output.push_str(&format!("Total  {total}s\n"));
    output
}

#[cfg(test)]
mod tests {
    use chrono::{TimeZone, Utc};

    use super::*;

    fn entry(id: i64, start: &str, duration: i64, billable: bool, stopped: bool) -> TimeEntry {
        let start = Utc.datetime_from_str(start, "%Y-%m-%dT%H:%M:%SZ").unwrap();
        TimeEntry {
            id,
            description: String::new(),
            start,
            stop: stopped.then(|| start + chrono::Duration::seconds(duration)),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_stopped_billable_entries_by_utc_iso_week_and_rounds_each_entry() {
        let entries = vec![
            entry(1, "2026-03-01T23:30:00Z", 901, true, true),
            entry(2, "2026-03-02T00:30:00Z", 1_800, true, true),
            entry(3, "2026-03-04T12:00:00Z", 60, true, false),
            entry(4, "2026-03-05T12:00:00Z", 60, false, true),
        ];

        let weeks = billable_seconds_by_week(&entries);
        assert_eq!(weeks.len(), 2);
        assert_eq!(weeks[&NaiveDate::from_ymd_opt(2026, 2, 23).unwrap()], 1_800);
        assert_eq!(weeks[&NaiveDate::from_ymd_opt(2026, 3, 2).unwrap()], 1_800);
    }

    #[test]
    fn empty_when_no_stopped_billable_entries() {
        let entries = vec![
            entry(1, "2026-03-02T12:00:00Z", 60, false, true),
            entry(2, "2026-03-02T13:00:00Z", 60, true, false),
        ];

        assert!(billable_seconds_by_week(&entries).is_empty());
    }

    #[test]
    fn billing_rounding_is_per_entry() {
        let entries = vec![
            entry(1, "2026-03-02T12:00:00Z", 1, true, true),
            entry(2, "2026-03-02T13:00:00Z", 1, true, true),
        ];

        let weeks = billable_seconds_by_week(&entries);
        assert_eq!(weeks[&NaiveDate::from_ymd_opt(2026, 3, 2).unwrap()], 1_800);
    }

    #[test]
    fn formats_weeks_and_empty_results_for_human_output() {
        let mut weeks = BTreeMap::new();
        weeks.insert(NaiveDate::from_ymd_opt(2026, 2, 23).unwrap(), 1_800);
        weeks.insert(NaiveDate::from_ymd_opt(2026, 3, 2).unwrap(), 2_700);

        assert_eq!(
            format_billable_weeks(&weeks),
            "2026-02-23  1800s\n2026-03-02  2700s\nTotal  4500s\n"
        );
        assert_eq!(format_billable_weeks(&BTreeMap::new()), "(no data)\n");
    }
}
