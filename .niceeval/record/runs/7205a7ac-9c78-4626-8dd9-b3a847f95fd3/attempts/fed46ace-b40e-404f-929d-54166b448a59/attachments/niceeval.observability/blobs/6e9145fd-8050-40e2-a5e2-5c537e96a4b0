n      \"room\": null,\n      \"confidence\": 0.0,\n      \"reason\": \"global search: no taxonomy keyword match\"\n    },\n    \"memory_kind\": \"evidence\",\n    \"domain\": \"project\",\n    \"field\": \"general\",\n    \"anchor_kind\": \"repo\",\n    \"anchor_id\": \"repo://legacy\"\n  },\n  {\n    \"drawer_id\": \"drawer_memory_evals_default_788adc56d41d\",\n    \"content\": \"# Treat document blur separately from focus transfer\\n\\nFor combobox blur selection, `relatedTarget` distinguishes a user moving focus within the page from focus leaving the document, such as a browser tab or window switch. A null target should close transient UI without confirming a highlighted item, while a real target preserves the existing selection-on-blur behavior.\",\n    \"wing\": \"memory-evals\",\n    \"room\": \"default\",\n    \"source_file\": \"combobox-document-blur-selection.md\",\n    \"similarity\": -0.35151482,\n    \"route\": {\n      \"wing\": null,\n      \"room\": null,\n      \"confidence\": 0.0,\n      \"reason\": \"global search: no taxonomy keyword match\"\n    },\n    \"memory_kind\": \"evidence\",\n    \"domain\": \"project\",\n    \"field\": \"general\",\n    \"anchor_kind\": \"repo\",\n    \"anchor_id\": \"repo://legacy\"\n  },\n  {\n    \"drawer_id\": \"drawer_memory_evals_default_f2abe6e1f36b\",\n    \"content\": \"# Guard keyboard actions with their active target\\n\\nWhen a shared key handler is attached to several focusable elements, reducer state alone may identify an active target but not prove that the current event originated there. Pass the target identity through the action and require it to match valid active state before applying a destructive update. Keep action fields optional when internal callers legitimately dispatch the same action without a DOM origin.\",\n    \"wing\": \"memory-evals\",\n    \"room\": \"default\",\n    \"source_file\": \"guard-key-actions-by-active-target.md\",\n    \"similarity\": -0.364231,\n    \"route\": {\n      \"wing\": null,\n      \"room\": null,\n      \"confidence\": 0.0,\n      \"reason\": \"global search: no taxonomy keyword match\"\n    },\n    \"memory_kind\": \"evidence\",\n    \"domain\": \"project\",\n    \"field\": \"general\",\n    \"anchor_kind\": \"repo\",\n    \"anchor_id\": \"repo://legacy\"\n  },\n  {\n    \"drawer_id\": \"drawer_memory_evals_default_c09250a717d8\",\n    \"content\": \"# Validate configured highlight candidates before opening\\n\\nWhen a dropdown computes its opening highlight from configured indexes, validate those candidates with the same disabled-item predicate used by keyboard navigation. A disabled candidate should fall through the established priority chain, and directional final fallbacks should use the shared non-disabled index helper so opening cannot land on a disabled item.\",\n    \"wing\": \"memory-evals\",\n    \"room\": \"default\",\n    \"source_file\": \"downshift-disabled-open-highlight.md\",\n    \"similarity\": -0.38156426,\n    \"route\": {\n      \"wing\": null,\n      \"room\": null,\n      \"confidence\": 0.0,\n      \"reason\": \"global search: no taxonomy keyword match\"\n    },\n    \"memory_kind\": \"evidence\",\n    \"domain\": \"project\",\n    \"field\": \"general\",\n    \"anchor_kind\": \"repo\",\n    \"anchor_id\": \"repo://legacy\"\n  }\n]\n","exit_code":0,"status":"completed"}}
