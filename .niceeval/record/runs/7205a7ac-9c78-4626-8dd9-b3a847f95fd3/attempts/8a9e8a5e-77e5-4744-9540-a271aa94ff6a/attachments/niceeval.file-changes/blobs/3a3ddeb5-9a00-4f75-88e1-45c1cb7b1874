use std::{
    collections::HashMap,
    io::{self, BufWriter, Write},
};

use crate::{
    api::client::ApiClient,
    constants::NO_PROJECT,
    models::{ResultWithDefaultError, TimeEntry},
    utilities,
};
use serde_json::{json, Value};

pub struct EntryStatsCommand;

impl EntryStatsCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json_output: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let project_totals = project_totals(&entries);
        let total = project_totals
            .iter()
            .map(|(_, seconds)| seconds)
            .sum::<i64>();

        if json_output {
            println!(
                "{}",
                serde_json::to_string(&stats_json(&project_totals, total))
                    .expect("failed to serialize stats")
            );
            return Ok(());
        }

        let stdout = io::stdout();
        let mut output = BufWriter::new(stdout);
        for (project, seconds) in project_totals {
            writeln!(
                output,
                "{}  {project}",
                utilities::format_duration_compact(seconds)
            )
            .expect("failed to print");
        }
        writeln!(
            output,
            "{}  Total",
            utilities::format_duration_compact(total)
        )
        .expect("failed to print");

        Ok(())
    }
}

fn stats_json(project_totals: &[(String, i64)], total: i64) -> Value {
    let groups = project_totals
        .iter()
        .map(|(project, seconds)| json!({ "project": project, "seconds": seconds }))
        .collect::<Vec<_>>();
    json!({ "groups": groups, "total_seconds": total })
}

fn project_totals(entries: &[TimeEntry]) -> Vec<(String, i64)> {
    let mut totals = HashMap::new();

    for entry in entries.iter().filter(|entry| entry.duration >= 0) {
        let project = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| NO_PROJECT.to_string());
        *totals.entry(project).or_insert(0) += entry.duration;
    }

    let mut totals: Vec<_> = totals.into_iter().collect();
    totals.sort_by(|(left_name, left_duration), (right_name, right_duration)| {
        right_duration
            .cmp(left_duration)
            .then_with(|| left_name.cmp(right_name))
    });
    totals
}

#[cfg(test)]
mod tests {
    use chrono::{TimeZone, Utc};

    use super::{project_totals, stats_json};
    use crate::models::{Project, TimeEntry};

    fn entry(duration: i64, project: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).single().unwrap(),
            stop: Some(Utc.timestamp_opt(0, 0).single().unwrap()),
            duration,
            billable: false,
            workspace_id: 1,
            tags: vec![],
            project: project.map(|name| Project {
                id: 1,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).single().unwrap(),
                created_at: Utc.timestamp_opt(0, 0).single().unwrap(),
                color: String::new(),
                billable: None,
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_completed_entries_and_sorts_by_duration_then_name() {
        let entries = vec![
            entry(3600, Some("Beta")),
            entry(1800, Some("Alpha")),
            entry(1800, Some("Alpha")),
            entry(3600, Some("Gamma")),
            entry(900, None),
            entry(-100, Some("Ignored")),
        ];

        assert_eq!(
            project_totals(&entries),
            vec![
                ("Alpha".to_string(), 3600),
                ("Beta".to_string(), 3600),
                ("Gamma".to_string(), 3600),
                ("No Project".to_string(), 900),
            ]
        );
    }

    #[test]
    fn stats_json_uses_seconds_and_preserves_group_order() {
        let totals = vec![("Alpha".to_string(), 5400), ("Beta".to_string(), 1800)];

        assert_eq!(
            stats_json(&totals, 7200),
            serde_json::json!({
                "groups": [
                    { "project": "Alpha", "seconds": 5400 },
                    { "project": "Beta", "seconds": 1800 },
                ],
                "total_seconds": 7200,
            })
        );
    }
}
