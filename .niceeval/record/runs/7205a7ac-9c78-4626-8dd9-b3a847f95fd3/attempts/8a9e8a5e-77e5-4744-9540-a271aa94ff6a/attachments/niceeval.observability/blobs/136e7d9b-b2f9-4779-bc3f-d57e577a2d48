t entries = vec![\n            entry(3600, Some(\"Beta\")),\n            entry(1800, Some(\"Alpha\")),\n            entry(1800, Some(\"Alpha\")),\n            entry(3600, Some(\"Gamma\")),\n            entry(900, None),\n            entry(-100, Some(\"Ignored\")),\n        ];\n\n        assert_eq!(\n            project_totals(&entries),\n            vec![\n                (\"Alpha\".to_string(), 3600),\n                (\"Beta\".to_string(), 3600),\n                (\"Gamma\".to_string(), 3600),\n                (\"No Project\".to_string(), 900),\n            ]\n        );\n    }\n\n    #[test]\n    fn stats_json_uses_seconds_and_preserves_group_order() {\n        let totals = vec![(\"Alpha\".to_string(), 5400), (\"Beta\".to_string(), 1800)];\n\n        assert_eq!(\n            stats_json(&totals, 7200),\n            serde_json::json!({\n                \"groups\": [\n                    { \"project\": \"Alpha\", \"seconds\": 5400 },\n                    { \"project\": \"Beta\", \"seconds\": 1800 },\n                ],\n                \"total_seconds\": 7200,\n            })\n        );\n    }\n}\n","exit_code":0,"status":"completed"}}
