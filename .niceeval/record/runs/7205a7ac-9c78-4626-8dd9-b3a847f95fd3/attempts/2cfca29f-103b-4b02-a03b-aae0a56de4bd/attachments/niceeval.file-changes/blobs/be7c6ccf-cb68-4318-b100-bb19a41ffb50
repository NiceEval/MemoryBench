use crate::api::client::ApiClient;
use crate::constants::NO_PROJECT;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

const BILLING_UNIT_SECONDS: i64 = 15 * 60;

pub struct BillCommand;

fn round_up_to_billing_unit(seconds: i64) -> i64 {
    if seconds <= 0 {
        0
    } else {
        ((seconds + BILLING_UNIT_SECONDS - 1) / BILLING_UNIT_SECONDS) * BILLING_UNIT_SECONDS
    }
}

fn billable_time_by_project(entries: Vec<TimeEntry>) -> Vec<(String, i64)> {
    let mut totals = HashMap::new();

    for entry in entries
        .into_iter()
        .filter(|entry| entry.billable && entry.stop.is_some())
    {
        let project_name = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| NO_PROJECT.to_string());
        *totals.entry(project_name).or_insert(0) += round_up_to_billing_unit(entry.duration);
    }

    let mut totals: Vec<_> = totals.into_iter().collect();
    totals.sort_by(|(left_name, left_seconds), (right_name, right_seconds)| {
        right_seconds
            .cmp(left_seconds)
            .then_with(|| left_name.cmp(right_name))
    });
    totals
}

fn write_bill_summary(handle: &mut impl Write, totals: &[(String, i64)]) {
    if totals.is_empty() {
        writeln!(handle, "(no data)").expect("failed to print");
        return;
    }

    let total_seconds: i64 = totals.iter().map(|(_, seconds)| seconds).sum();
    for (project, seconds) in totals {
        writeln!(handle, "{seconds}s  {project}").expect("failed to print");
    }
    writeln!(handle, "{total_seconds}s  Total").expect("failed to print");
}

impl BillCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let totals = billable_time_by_project(entries);
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);
        write_bill_summary(&mut handle, &totals);
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::api::client::MockApiClient;
    use crate::models::Project;
    use chrono::{TimeZone, Utc};
    use tokio_test::assert_ok;

    fn entry(duration: i64, billable: bool, stopped: bool, project: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).single().unwrap(),
            stop: stopped.then(|| Utc.timestamp_opt(duration, 0).single().unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: project.map(|name| Project {
                id: 1,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).single().unwrap(),
                created_at: Utc.timestamp_opt(0, 0).single().unwrap(),
                color: String::new(),
                billable: None,
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn aggregates_only_stopped_billable_entries_and_rounds_each_entry_up() {
        let totals = billable_time_by_project(vec![
            entry(7 * 60, true, true, Some("Alpha")),
            entry(22 * 60, true, true, Some("Alpha")),
            entry(16 * 60, true, true, None),
            entry(60 * 60, false, true, Some("Ignored")),
            entry(60 * 60, true, false, Some("Ignored")),
        ]);

        assert_eq!(
            totals,
            vec![
                ("Alpha".to_string(), 45 * 60),
                (NO_PROJECT.to_string(), 30 * 60)
            ]
        );
    }

    #[test]
    fn orders_equal_project_totals_alphabetically() {
        let totals = billable_time_by_project(vec![
            entry(15 * 60, true, true, Some("Zulu")),
            entry(15 * 60, true, true, Some("Alpha")),
        ]);

        assert_eq!(
            totals,
            vec![
                ("Alpha".to_string(), 15 * 60),
                ("Zulu".to_string(), 15 * 60)
            ]
        );
    }

    #[test]
    fn prints_no_data_for_empty_totals() {
        let mut output = Vec::new();
        write_bill_summary(&mut output, &[]);
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");
    }

    #[tokio::test]
    async fn normalizes_date_filters_before_fetching_entries() {
        let mut api_client = MockApiClient::new();
        let (expected_since, expected_until) = utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .unwrap();
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected_since && *until == expected_until)
            .returning(|_, _| Ok(Vec::new()));

        assert_ok!(
            BillCommand::execute(
                api_client,
                Some("2026-01-01".to_string()),
                Some("2026-01-31".to_string()),
            )
            .await
        );
    }
}
