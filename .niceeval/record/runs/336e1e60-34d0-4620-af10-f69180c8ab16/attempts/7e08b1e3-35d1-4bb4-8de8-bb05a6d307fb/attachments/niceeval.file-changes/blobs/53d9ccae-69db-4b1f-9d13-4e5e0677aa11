use crate::api::client::ApiClient;
use crate::constants::NO_PROJECT;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde_json::json;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

const BILLING_UNIT_SECONDS: i64 = 15 * 60;

pub struct BillCommand;

fn round_up_to_billing_unit(seconds: i64) -> i64 {
    seconds.max(0).saturating_add(BILLING_UNIT_SECONDS - 1) / BILLING_UNIT_SECONDS
        * BILLING_UNIT_SECONDS
}

fn billable_seconds_by_project(entries: impl IntoIterator<Item = TimeEntry>) -> Vec<(String, i64)> {
    let mut totals = HashMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() || entry.is_running() {
            continue;
        }

        let project = entry
            .project
            .map(|project| project.name)
            .unwrap_or_else(|| NO_PROJECT.to_string());
        *totals.entry(project).or_insert(0) += round_up_to_billing_unit(entry.duration);
    }

    let mut totals: Vec<_> = totals.into_iter().collect();
    totals.sort_by(
        |(left_project, left_seconds), (right_project, right_seconds)| {
            right_seconds
                .cmp(left_seconds)
                .then_with(|| left_project.cmp(right_project))
        },
    );
    totals
}

fn write_bill_summary(handle: &mut impl Write, totals: &[(String, i64)]) -> io::Result<()> {
    if totals.is_empty() {
        writeln!(handle, "(no data)")?;
        return Ok(());
    }

    let total: i64 = totals.iter().map(|(_, seconds)| seconds).sum();
    for (project, seconds) in totals {
        writeln!(handle, "{seconds}s  {project}")?;
    }
    writeln!(handle, "{total}s  Total")
}

fn bill_summary_to_json(totals: &[(String, i64)]) -> String {
    let total_billable_seconds: i64 = totals.iter().map(|(_, seconds)| seconds).sum();
    let projects: Vec<_> = totals
        .iter()
        .map(|(project, billable_seconds)| {
            json!({
                "project": project,
                "billable_seconds": billable_seconds,
            })
        })
        .collect();
    serde_json::to_string(&json!({
        "projects": projects,
        "total_billable_seconds": total_billable_seconds,
    }))
    .expect("failed to serialize bill summary")
}

impl BillCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let totals = billable_seconds_by_project(entries);
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);
        if json {
            writeln!(handle, "{}", bill_summary_to_json(&totals)).expect("failed to print");
        } else {
            write_bill_summary(&mut handle, &totals).expect("failed to print");
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::models::Project;
    use chrono::{TimeZone, Utc};

    fn project(name: &str) -> Project {
        Project {
            id: 1,
            name: name.to_string(),
            workspace_id: 1,
            client: None,
            is_private: false,
            active: true,
            at: Utc.timestamp_opt(0, 0).single().unwrap(),
            created_at: Utc.timestamp_opt(0, 0).single().unwrap(),
            color: "#000000".to_string(),
            billable: None,
        }
    }

    fn entry(duration: i64, billable: bool, project_name: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).single().unwrap(),
            stop: Some(Utc.timestamp_opt(duration, 0).single().unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: project_name.map(project),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn rounds_each_billable_entry_before_grouping() {
        let totals = billable_seconds_by_project(vec![
            entry(7 * 60, true, Some("Acme")),
            entry(22 * 60, true, Some("Acme")),
            entry(60 * 60, false, Some("Internal")),
        ]);

        assert_eq!(totals, vec![("Acme".to_string(), 45 * 60)]);
    }

    #[test]
    fn ignores_running_entries_and_uses_no_project_label() {
        let mut running = entry(7 * 60, true, Some("Acme"));
        running.stop = None;
        running.duration = -running.start.timestamp();

        let totals = billable_seconds_by_project(vec![running, entry(1, true, None)]);

        assert_eq!(totals, vec![(NO_PROJECT.to_string(), 15 * 60)]);
    }

    #[test]
    fn sorts_by_duration_then_project_name() {
        let totals = billable_seconds_by_project(vec![
            entry(16 * 60, true, Some("Zulu")),
            entry(15 * 60, true, Some("Alpha")),
            entry(1, true, Some("Bravo")),
        ]);

        assert_eq!(
            totals,
            vec![
                ("Zulu".to_string(), 30 * 60),
                ("Alpha".to_string(), 15 * 60),
                ("Bravo".to_string(), 15 * 60),
            ]
        );
    }

    #[test]
    fn writes_empty_and_total_summaries() {
        let mut output = Vec::new();
        write_bill_summary(&mut output, &[]).unwrap();
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");

        let mut output = Vec::new();
        write_bill_summary(
            &mut output,
            &[("Acme".to_string(), 1800), (NO_PROJECT.to_string(), 900)],
        )
        .unwrap();
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "1800s  Acme\n900s  No Project\n2700s  Total\n"
        );
    }

    #[test]
    fn serializes_ordered_bill_summary_as_json() {
        let json =
            bill_summary_to_json(&[("Alpha".to_string(), 2700), (NO_PROJECT.to_string(), 2700)]);
        assert_eq!(
            json,
            r#"{"projects":[{"project":"Alpha","billable_seconds":2700},{"project":"No Project","billable_seconds":2700}],"total_billable_seconds":5400}"#
        );
    }

    #[test]
    fn serializes_an_empty_bill_summary_as_json() {
        assert_eq!(
            bill_summary_to_json(&[]),
            r#"{"projects":[],"total_billable_seconds":0}"#
        );
    }
}
