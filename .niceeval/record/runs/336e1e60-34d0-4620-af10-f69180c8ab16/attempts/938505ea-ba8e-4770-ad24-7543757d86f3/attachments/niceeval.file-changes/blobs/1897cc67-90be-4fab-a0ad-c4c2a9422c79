use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

use crate::api::client::ApiClient;
use crate::constants;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde_json::{json, Value};

pub struct EntryStatsCommand;

impl EntryStatsCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json_output: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let stats = project_durations(&entries);
        let total = total_duration(&entries);

        if json_output {
            println!(
                "{}",
                serde_json::to_string(&stats_json(&stats, total))
                    .expect("failed to serialize stats to JSON")
            );
            return Ok(());
        }

        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);
        for (project, duration) in stats {
            writeln!(
                handle,
                "{}  {project}",
                utilities::format_duration_compact(duration)
            )
            .expect("failed to print");
        }
        writeln!(
            handle,
            "{}  Total",
            utilities::format_duration_compact(total)
        )
        .expect("failed to print");
        Ok(())
    }
}

fn stats_json(groups: &[(String, i64)], total_seconds: i64) -> Value {
    let groups = groups
        .iter()
        .map(|(project, seconds)| json!({ "project": project, "seconds": seconds }))
        .collect::<Vec<_>>();
    json!({ "groups": groups, "total_seconds": total_seconds })
}

fn project_durations(entries: &[TimeEntry]) -> Vec<(String, i64)> {
    let mut durations = HashMap::new();

    for entry in entries.iter().filter(|entry| entry.duration >= 0) {
        let project = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| constants::NO_PROJECT.to_string());
        *durations.entry(project).or_insert(0) += entry.duration;
    }

    let mut durations: Vec<_> = durations.into_iter().collect();
    durations.sort_by(|(left_name, left_duration), (right_name, right_duration)| {
        right_duration
            .cmp(left_duration)
            .then_with(|| left_name.cmp(right_name))
    });
    durations
}

fn total_duration(entries: &[TimeEntry]) -> i64 {
    entries
        .iter()
        .filter(|entry| entry.duration >= 0)
        .map(|entry| entry.duration)
        .sum()
}

#[cfg(test)]
mod tests {
    use super::{project_durations, stats_json, total_duration};
    use crate::models::TimeEntry;
    use chrono::{TimeZone, Utc};

    fn entry(project: Option<&str>, duration: i64) -> TimeEntry {
        TimeEntry {
            duration,
            project: project.map(|name| crate::models::Project {
                id: 1,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: Utc.timestamp_opt(0, 0).single().unwrap(),
                created_at: Utc.timestamp_opt(0, 0).single().unwrap(),
                color: "#000000".to_string(),
                billable: None,
            }),
            ..TimeEntry::default()
        }
    }

    #[test]
    fn project_durations_groups_sorts_and_ignores_running_entries() {
        let entries = vec![
            entry(Some("Beta"), 1_800),
            entry(Some("Alpha"), 1_800),
            entry(Some("Alpha"), 900),
            entry(None, 600),
            entry(Some("Ignored"), -1),
        ];

        assert_eq!(
            project_durations(&entries),
            vec![
                ("Alpha".to_string(), 2_700),
                ("Beta".to_string(), 1_800),
                ("No Project".to_string(), 600),
            ]
        );
        assert_eq!(total_duration(&entries), 5_100);
    }

    #[test]
    fn stats_json_uses_raw_seconds_and_snake_case_keys() {
        let groups = vec![("Alpha".to_string(), 5_400), ("Beta".to_string(), 1_800)];

        assert_eq!(
            stats_json(&groups, 7_200),
            serde_json::json!({
                "groups": [
                    { "project": "Alpha", "seconds": 5_400 },
                    { "project": "Beta", "seconds": 1_800 }
                ],
                "total_seconds": 7_200
            })
        );
    }
}
