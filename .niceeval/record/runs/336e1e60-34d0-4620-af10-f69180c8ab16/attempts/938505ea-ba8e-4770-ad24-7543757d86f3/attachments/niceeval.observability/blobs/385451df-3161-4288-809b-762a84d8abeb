ek\" => {}\n            other => panic!(\"unexpected parse result: {other:?}\"),\n        }\n    }\n\n    #[test]\n    fn entry_start_parses() {\n        let cmd = Cli::try_parse_from([\"toggl\", \"entry\", \"start\", \"-d\", \"Test entry\"])\n            .expect(\"should parse\");\n        match cmd.cmd {\n            Command::Entry {\n                action:\n                    EntryAction::Start {\n                        description: Some(d),\n                        ..\n                    },\n            } if d == \"Test entry\" => {}\n","exit_code":0,"status":"completed"}}
