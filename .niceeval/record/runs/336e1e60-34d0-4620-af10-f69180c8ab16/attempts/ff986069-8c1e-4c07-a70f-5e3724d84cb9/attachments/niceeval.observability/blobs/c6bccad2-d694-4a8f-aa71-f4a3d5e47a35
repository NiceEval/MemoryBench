{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' src/commands/invoice.rs && sed -n '165,200p' src/arguments.rs && sed -n '730,758p' src/arguments.rs && sed -n '250,265p' src/main.rs && git status --short\"","aggregated_output":"use crate::api::client::ApiClient;\nuse crate::models::{ResultWithDefaultError, TimeEntry};\nuse crate::utilities;\nuse std::collections::HashMap;\n\nconst ROUNDING_INCREMENT_SECONDS: i64 = 15 * 60;\nconst MINIMUM_BILLING_SECONDS: i64 = 30 * 60;\n\npub struct InvoiceCommand;\n\n#[derive(Debug, PartialEq, Eq)]\nstruct InvoiceLine {\n    project: String,\n    seconds: i64,\n}\n\nfn billed_seconds(duration: i64) -> i64 {\n    let rounded = ((duration + ROUNDING_INCREMENT_SECONDS - 1) / ROUNDING_INCREMENT_SECONDS)\n        * ROUNDING_INCREMENT_SECONDS;\n    rounded.max(MINIMUM_BILLING_SECONDS)\n}\n\nfn invoice_lines(entries: &[TimeEntry]) -> Vec<InvoiceLine> {\n    let mut totals = HashMap::new();\n\n    for entry in entries {\n        if !entry.billable || entry.stop.is_none() || entry.is_running() {\n            continue;\n        }\n\n        let project = entry\n            .project\n            .as_ref()\n            .map(|project| (Some(project.id), project.name.clone()))\n            .unwrap_or((None, \"No Project\".to_string()));\n        *totals.entry(project).or_insert(0) += billed_seconds(entry.duration);\n    }\n\n    let mut lines: Vec<_> = totals\n        .into_iter()\n        .map(|((_project_id, project), seconds)| InvoiceLine { project, seconds })\n        .collect();\n    lines.sort_by(|left, right| {\n        right\n            .seconds\n            .cmp(&left.seconds)\n            .then_with(|| left.project.cmp(&right.project))\n    });\n    lines\n}\n\nfn render_invoice(entries: &[TimeEntry]) -> String {\n    let lines = invoice_lines(entries);\n    if lines.is_empty() {\n        return \"(no data)\\n\".to_string();\n    }\n\n    let total: i64 = lines.iter().map(|line| line.seconds).sum();\n    let mut output = lines\n        .iter()\n        .map(|line| format!(\"{}s  {}\", line.seconds, line.project))\n        .collect::<Vec<_>>()\n        .join(\"\\n\");\n    output.push_str(&format!(\"\\n{}s  Total\\n\", total));\n    output\n}\n\nimpl InvoiceCommand {\n    pub async fn execute(\n        api_client: impl ApiClient,\n        since: Option<String>,\n        until: Option<String>,\n    ) -> ResultWithDefaultError<()> {\n        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;\n        let entries = api_client.get_time_entries_filtered(since, until).await?;\n        print!(\"{}\", render_invoice(&entries));\n        Ok(())\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::api::client::MockApiClient;\n    use crate::models::{Project, TimeEntry};\n    use chrono::Utc;\n\n    fn make_project(name: &str) -> Project {\n        Project {\n            id: 1,\n            name: name.to_string(),\n            workspace_id: 1,\n            client: None,\n            is_private: false,\n            active: true,\n            at: Utc::now(),\n            created_at: Utc::now(),\n            color: \"#000000\".to_string(),\n            billable: None,\n        }\n    }\n\n    fn entry(duration: i64, billable: bool, project_name: Option<&str>) -> TimeEntry {\n        TimeEntry {\n            id: 1,\n            description: \"Entry\".to_string(),\n            start: Utc::now(),\n            stop: Some(Utc::now()),\n            duration,\n            billable,\n            workspace_id: 1,\n            tags: Vec::new(),\n            project: project_name.map(make_project),\n            task: None,\n            created_with: None,\n        }\n    }\n\n    #[test]\n    fn invoice_rounds_each_entry_and_applies_minimum_before_grouping() {\n        let entries = vec![\n            entry(1, true, Some(\"Alpha\")),\n            entry(1_801, true, Some(\"Alpha\")),\n            entry(2