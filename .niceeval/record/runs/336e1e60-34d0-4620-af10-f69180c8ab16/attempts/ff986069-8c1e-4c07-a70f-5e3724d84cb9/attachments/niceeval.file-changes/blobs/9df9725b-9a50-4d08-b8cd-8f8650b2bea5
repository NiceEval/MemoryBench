use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde::Serialize;
use std::collections::HashMap;

const ROUNDING_INCREMENT_SECONDS: i64 = 15 * 60;
const MINIMUM_BILLING_SECONDS: i64 = 30 * 60;

pub struct InvoiceCommand;

#[derive(Debug, PartialEq, Eq)]
struct InvoiceLine {
    project: String,
    seconds: i64,
}

#[derive(Serialize)]
struct InvoiceProject {
    project: String,
    billable_seconds: i64,
}

#[derive(Serialize)]
struct InvoiceReport {
    projects: Vec<InvoiceProject>,
    total_billable_seconds: i64,
}

fn billed_seconds(duration: i64) -> i64 {
    let rounded = ((duration + ROUNDING_INCREMENT_SECONDS - 1) / ROUNDING_INCREMENT_SECONDS)
        * ROUNDING_INCREMENT_SECONDS;
    rounded.max(MINIMUM_BILLING_SECONDS)
}

fn invoice_lines(entries: &[TimeEntry]) -> Vec<InvoiceLine> {
    let mut totals = HashMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() || entry.is_running() {
            continue;
        }

        let project = entry
            .project
            .as_ref()
            .map(|project| (Some(project.id), project.name.clone()))
            .unwrap_or((None, "No Project".to_string()));
        *totals.entry(project).or_insert(0) += billed_seconds(entry.duration);
    }

    let mut lines: Vec<_> = totals
        .into_iter()
        .map(|((_project_id, project), seconds)| InvoiceLine { project, seconds })
        .collect();
    lines.sort_by(|left, right| {
        right
            .seconds
            .cmp(&left.seconds)
            .then_with(|| left.project.cmp(&right.project))
    });
    lines
}

fn render_invoice(entries: &[TimeEntry]) -> String {
    let lines = invoice_lines(entries);
    if lines.is_empty() {
        return "(no data)\n".to_string();
    }

    let total: i64 = lines.iter().map(|line| line.seconds).sum();
    let mut output = lines
        .iter()
        .map(|line| format!("{}s  {}", line.seconds, line.project))
        .collect::<Vec<_>>()
        .join("\n");
    output.push_str(&format!("\n{}s  Total\n", total));
    output
}

fn render_invoice_json(entries: &[TimeEntry]) -> String {
    let lines = invoice_lines(entries);
    let total_billable_seconds = lines.iter().map(|line| line.seconds).sum();
    let projects = lines
        .into_iter()
        .map(|line| InvoiceProject {
            project: line.project,
            billable_seconds: line.seconds,
        })
        .collect();

    serde_json::to_string(&InvoiceReport {
        projects,
        total_billable_seconds,
    })
    .expect("failed to serialize invoice JSON")
}

impl InvoiceCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        if json {
            println!("{}", render_invoice_json(&entries));
        } else {
            print!("{}", render_invoice(&entries));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::api::client::MockApiClient;
    use crate::models::{Project, TimeEntry};
    use chrono::Utc;

    fn make_project(name: &str) -> Project {
        Project {
            id: 1,
            name: name.to_string(),
            workspace_id: 1,
            client: None,
            is_private: false,
            active: true,
            at: Utc::now(),
            created_at: Utc::now(),
            color: "#000000".to_string(),
            billable: None,
        }
    }

    fn entry(duration: i64, billable: bool, project_name: Option<&str>) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: "Entry".to_string(),
            start: Utc::now(),
            stop: Some(Utc::now()),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: project_name.map(make_project),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn invoice_rounds_each_entry_and_applies_minimum_before_grouping() {
        let entries = vec![
            entry(1, true, Some("Alpha")),
            entry(1_801, true, Some("Alpha")),
            entry(2_701, true, None),
        ];

        assert_eq!(
            render_invoice(&entries),
            "4500s  Alpha\n3600s  No Project\n8100s  Total\n"
        );
    }

    #[test]
    fn invoice_ignores_non_billable_and_running_entries() {
        let mut running = entry(-Utc::now().timestamp(), true, Some("Ignored"));
        running.stop = None;
        let entries = vec![entry(3_600, false, Some("Ignored")), running];

        assert_eq!(render_invoice(&entries), "(no data)\n");
    }

    #[test]
    fn invoice_sorts_by_descending_billed_seconds_then_project_name() {
        let entries = vec![
            entry(1_800, true, Some("Zeta")),
            entry(1_800, true, Some("Alpha")),
            entry(3_600, true, Some("Long")),
        ];

        assert_eq!(
            render_invoice(&entries),
            "3600s  Long\n1800s  Alpha\n1800s  Zeta\n7200s  Total\n"
        );
    }

    #[test]
    fn invoice_json_uses_the_human_output_order_and_schema() {
        let entries = vec![
            entry(1_800, true, Some("Zeta")),
            entry(1_800, true, Some("Alpha")),
            entry(3_600, true, Some("Long")),
        ];

        assert_eq!(
            render_invoice_json(&entries),
            r#"{"projects":[{"project":"Long","billable_seconds":3600},{"project":"Alpha","billable_seconds":1800},{"project":"Zeta","billable_seconds":1800}],"total_billable_seconds":7200}"#
        );
    }

    #[test]
    fn invoice_json_returns_an_empty_report_when_nothing_is_billable() {
        assert_eq!(
            render_invoice_json(&[entry(3_600, false, Some("Ignored"))]),
            r#"{"projects":[],"total_billable_seconds":0}"#
        );
    }

    #[tokio::test]
    async fn invoice_normalizes_date_filters_before_fetching_entries() {
        let mut api_client = MockApiClient::new();
        let (expected_since, expected_until) = utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .expect("date range should normalize");
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected_since && *until == expected_until)
            .returning(|_, _| Ok(Vec::new()));

        InvoiceCommand::execute(
            api_client,
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
            false,
        )
        .await
        .expect("invoice should succeed");
    }
}
