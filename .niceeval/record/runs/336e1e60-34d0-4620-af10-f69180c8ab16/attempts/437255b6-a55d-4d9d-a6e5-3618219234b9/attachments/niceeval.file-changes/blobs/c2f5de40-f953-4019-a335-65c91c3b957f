import { fireEvent, render } from "@testing-library/react";
import React from "react";

import Calendar from "../calendar";
import { addMonths, formatDate, newDate, subMonths } from "../date_utils";

type CalendarProps = React.ComponentProps<typeof Calendar>;

describe("Multi month calendar", function () {
  const dateFormat = "LLLL yyyy";

  function getCalendar(
    extraProps: Partial<
      Pick<
        CalendarProps,
        "dateFormat" | "onSelect" | "onClickOutside" | "dropdownMode"
      >
    > &
      Omit<
        CalendarProps,
        | "dateFormat"
        | "onSelect"
        | "onClickOutside"
        | "dropdownMode"
        | "showMonthYearDropdown"
      >,
  ) {
    return render(
      <Calendar
        dateFormat={dateFormat}
        onSelect={() => {}}
        onClickOutside={() => {}}
        dropdownMode="scroll"
        {...extraProps}
      />,
    ).container;
  }

  it("should render multiple months if the months property is present", () => {
    const calendar = getCalendar({ monthsShown: 2 });
    const months = calendar.querySelectorAll(".react-datepicker__month");
    expect(months).toHaveLength(2);
  });

  it("should render dropdown only on first month", () => {
    const calendar = getCalendar({ monthsShown: 2, showYearDropdown: true });
    const datepickers = calendar.querySelectorAll(
      ".react-datepicker__year-dropdown-container",
    );
    expect(datepickers).toHaveLength(1);
  });

  it("should render previous months", () => {
    const calendar = getCalendar({ monthsShown: 2, showPreviousMonths: true });
    const monthDate = calendar.querySelector(
      ".react-datepicker__current-month",
    )?.textContent;
    const previousMonth = subMonths(newDate(), 1);
    expect(monthDate).toBe(formatDate(previousMonth, "LLLL yyyy"));
  });

  it("should render a middle header in every month after the day names", () => {
    const calendar = getCalendar({
      monthsShown: 2,
      monthHeaderPosition: "middle",
      showMonthDropdown: true,
    });
    const monthContainers = calendar.querySelectorAll(
      ".react-datepicker__month-container",
    );
    const headers = calendar.querySelectorAll(".react-datepicker__header");

    expect(headers).toHaveLength(2);
    expect(
      calendar.querySelectorAll(".react-datepicker__month-dropdown-container"),
    ).toHaveLength(2);

    monthContainers.forEach((container) => {
      const dayNames = container.querySelector(".react-datepicker__day-names")!;
      const header = container.querySelector(".react-datepicker__header")!;
      const month = container.querySelector(".react-datepicker__month")!;

      expect(dayNames.compareDocumentPosition(header)).toBe(
        Node.DOCUMENT_POSITION_FOLLOWING,
      );
      expect(header.compareDocumentPosition(month)).toBe(
        Node.DOCUMENT_POSITION_FOLLOWING,
      );
    });
  });

  it("should render a bottom header after days and navigate from it", () => {
    const calendar = getCalendar({ monthHeaderPosition: "bottom" });
    const header = calendar.querySelector(".react-datepicker__header")!;
    const month = calendar.querySelector(".react-datepicker__month")!;
    const nextButton = calendar.querySelector<HTMLButtonElement>(
      ".react-datepicker__navigation--next",
    )!;

    expect(month.compareDocumentPosition(header)).toBe(
      Node.DOCUMENT_POSITION_FOLLOWING,
    );

    fireEvent.click(nextButton);

    expect(
      calendar.querySelector(".react-datepicker__current-month")?.textContent,
    ).toBe(formatDate(addMonths(newDate(), 1), dateFormat));
  });

  it("should disable relocated navigation at date boundaries", () => {
    const calendar = getCalendar({
      monthHeaderPosition: "middle",
      minDate: newDate(),
      showDisabledMonthNavigation: true,
    });

    expect(
      calendar
        .querySelector(".react-datepicker__navigation--previous")
        ?.classList.contains(
          "react-datepicker__navigation--previous--disabled",
        ),
    ).toBe(true);
  });

  it("should render a custom header at the requested position", () => {
    const calendar = getCalendar({
      monthHeaderPosition: "bottom",
      renderCustomHeader: () => <div className="custom-month-header" />,
    });
    const customHeader = calendar.querySelector(".custom-month-header")!;
    const month = calendar.querySelector(".react-datepicker__month")!;

    expect(month.compareDocumentPosition(customHeader)).toBe(
      Node.DOCUMENT_POSITION_FOLLOWING,
    );
  });
});
