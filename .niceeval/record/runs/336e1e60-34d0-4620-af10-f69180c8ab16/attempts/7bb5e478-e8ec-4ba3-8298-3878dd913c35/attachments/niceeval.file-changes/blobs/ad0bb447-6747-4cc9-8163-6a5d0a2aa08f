use std::{
    collections::BTreeMap,
    io::{self, BufWriter, Write},
};

use chrono::{Datelike, NaiveDate};

use crate::{
    api::client::ApiClient,
    models::{ResultWithDefaultError, TimeEntry},
    utilities,
};

pub struct BillWeeklyCommand;

fn billable_seconds_by_week(
    entries: impl IntoIterator<Item = TimeEntry>,
) -> BTreeMap<NaiveDate, i64> {
    let mut weeks = BTreeMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() {
            continue;
        }

        let start_date = entry.start.date_naive();
        let monday =
            start_date - chrono::Duration::days(start_date.weekday().num_days_from_monday().into());
        *weeks.entry(monday).or_insert(0) += entry.duration;
    }

    weeks
}

fn write_summary(handle: &mut impl Write, weeks: &BTreeMap<NaiveDate, i64>) -> io::Result<()> {
    if weeks.is_empty() {
        writeln!(handle, "(no data)")?;
        return Ok(());
    }

    let total: i64 = weeks.values().sum();
    for (monday, seconds) in weeks {
        writeln!(handle, "{}  {seconds}s", monday.format("%Y-%m-%d"))?;
    }
    writeln!(handle, "Total  {total}s")
}

impl BillWeeklyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let entries = if since.is_some() || until.is_some() {
            let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
            api_client
                .get_time_entries_filtered_minimal(since, until)
                .await?
        } else {
            api_client.get_entities().await?.time_entries
        };

        let weeks = billable_seconds_by_week(entries);
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout.lock());
        write_summary(&mut handle, &weeks)
            .map_err(|error| -> Box<dyn std::error::Error + Send> { Box::new(error) })?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::{TimeZone, Utc};

    fn entry(
        id: i64,
        start: chrono::DateTime<Utc>,
        duration: i64,
        billable: bool,
        stopped: bool,
    ) -> TimeEntry {
        TimeEntry {
            id,
            description: String::new(),
            start,
            stop: stopped.then(|| start + chrono::Duration::seconds(duration)),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_completed_billable_entries_by_utc_iso_week() {
        let entries = vec![
            entry(
                1,
                Utc.with_ymd_and_hms(2026, 1, 4, 23, 59, 59).unwrap(),
                120,
                true,
                true,
            ),
            entry(
                2,
                Utc.with_ymd_and_hms(2026, 1, 5, 0, 0, 0).unwrap(),
                180,
                true,
                true,
            ),
            entry(
                3,
                Utc.with_ymd_and_hms(2026, 1, 7, 12, 0, 0).unwrap(),
                60,
                true,
                true,
            ),
            entry(
                4,
                Utc.with_ymd_and_hms(2026, 1, 6, 12, 0, 0).unwrap(),
                999,
                false,
                true,
            ),
            entry(
                5,
                Utc.with_ymd_and_hms(2026, 1, 6, 12, 0, 0).unwrap(),
                -1,
                true,
                false,
            ),
        ];

        let weeks = billable_seconds_by_week(entries);
        assert_eq!(weeks.len(), 2);
        assert_eq!(weeks[&NaiveDate::from_ymd_opt(2025, 12, 29).unwrap()], 120);
        assert_eq!(weeks[&NaiveDate::from_ymd_opt(2026, 1, 5).unwrap()], 240);
    }

    #[test]
    fn writes_empty_summary_to_stdout_format() {
        let mut output = Vec::new();
        write_summary(&mut output, &BTreeMap::new()).unwrap();
        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");
    }

    #[test]
    fn writes_weeks_oldest_first_with_total() {
        let mut weeks = BTreeMap::new();
        weeks.insert(NaiveDate::from_ymd_opt(2026, 1, 5).unwrap(), 240);
        weeks.insert(NaiveDate::from_ymd_opt(2025, 12, 29).unwrap(), 120);
        let mut output = Vec::new();

        write_summary(&mut output, &weeks).unwrap();
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "2025-12-29  120s\n2026-01-05  240s\nTotal  360s\n"
        );
    }
}
