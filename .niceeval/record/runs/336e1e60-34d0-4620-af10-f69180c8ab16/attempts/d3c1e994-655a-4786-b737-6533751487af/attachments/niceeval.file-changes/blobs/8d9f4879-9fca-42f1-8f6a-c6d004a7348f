use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde::Serialize;
use std::collections::BTreeMap;
use std::io::{self, BufWriter, Write};

const BILLING_UNIT_SECONDS: i64 = 15 * 60;
const MINIMUM_BILLABLE_SECONDS: i64 = 30 * 60;

pub struct InvoiceMonthlyCommand;

#[derive(Serialize)]
struct MonthlyInvoiceJson {
    months: Vec<MonthlyInvoiceMonth>,
    total_billable_seconds: i64,
}

#[derive(Serialize)]
struct MonthlyInvoiceMonth {
    month: String,
    billable_seconds: i64,
}

fn billed_duration_seconds(entry: &TimeEntry) -> Option<i64> {
    if !entry.billable || entry.is_running() || entry.stop.is_none() {
        return None;
    }

    let rounded = entry.duration.saturating_add(BILLING_UNIT_SECONDS - 1) / BILLING_UNIT_SECONDS
        * BILLING_UNIT_SECONDS;
    Some(rounded.max(MINIMUM_BILLABLE_SECONDS))
}

fn monthly_invoice_lines(entries: &[TimeEntry]) -> Vec<(String, i64)> {
    let mut by_month = BTreeMap::new();

    for entry in entries {
        let Some(billed_seconds) = billed_duration_seconds(entry) else {
            continue;
        };
        let month = entry.start.format("%Y-%m").to_string();
        *by_month.entry(month).or_insert(0) += billed_seconds;
    }

    by_month.into_iter().collect()
}

fn write_monthly_invoice(handle: &mut impl Write, lines: &[(String, i64)]) {
    if lines.is_empty() {
        writeln!(handle, "(no data)").expect("failed to print");
        return;
    }

    let total: i64 = lines.iter().map(|(_, seconds)| seconds).sum();
    for (month, seconds) in lines {
        writeln!(handle, "{month}  {seconds}s").expect("failed to print");
    }
    writeln!(handle, "Total  {total}s").expect("failed to print");
}

fn write_monthly_invoice_json(handle: &mut impl Write, lines: &[(String, i64)]) {
    let invoice = MonthlyInvoiceJson {
        months: lines
            .iter()
            .map(|(month, seconds)| MonthlyInvoiceMonth {
                month: month.clone(),
                billable_seconds: *seconds,
            })
            .collect(),
        total_billable_seconds: lines.iter().map(|(_, seconds)| seconds).sum(),
    };
    writeln!(
        handle,
        "{}",
        serde_json::to_string(&invoice).expect("failed to serialize monthly invoice")
    )
    .expect("failed to print");
}

impl InvoiceMonthlyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let lines = monthly_invoice_lines(&entries);
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout.lock());
        if json {
            write_monthly_invoice_json(&mut handle, &lines);
        } else {
            write_monthly_invoice(&mut handle, &lines);
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::api::client::MockApiClient;
    use chrono::{TimeZone, Utc};

    fn entry(start: chrono::DateTime<Utc>, duration: i64, billable: bool) -> TimeEntry {
        TimeEntry {
            id: 1,
            description: String::new(),
            start,
            stop: Some(start + chrono::Duration::seconds(duration)),
            duration,
            billable,
            workspace_id: 1,
            tags: Vec::new(),
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_by_utc_month_and_applies_invoice_billing_rule() {
        let january = Utc.with_ymd_and_hms(2026, 1, 31, 23, 30, 0).unwrap();
        let february = Utc.with_ymd_and_hms(2026, 2, 1, 0, 30, 0).unwrap();
        let lines = monthly_invoice_lines(&[
            entry(february, 901, true),
            entry(january, 1, true),
            entry(january, 3600, true),
        ]);

        assert_eq!(
            lines,
            vec![("2026-01".to_string(), 5400), ("2026-02".to_string(), 1800)]
        );
    }

    #[test]
    fn ignores_non_billable_and_running_entries() {
        let start = Utc.with_ymd_and_hms(2026, 3, 1, 0, 0, 0).unwrap();
        let mut running = entry(start, 600, true);
        running.stop = None;
        running.duration = -start.timestamp();

        assert!(monthly_invoice_lines(&[entry(start, 3600, false), running]).is_empty());
    }

    #[test]
    fn renders_human_output_and_empty_result() {
        let mut output = Vec::new();
        write_monthly_invoice(
            &mut output,
            &[("2026-01".to_string(), 1800), ("2026-02".to_string(), 3600)],
        );
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "2026-01  1800s\n2026-02  3600s\nTotal  5400s\n"
        );

        let mut empty = Vec::new();
        write_monthly_invoice(&mut empty, &[]);
        assert_eq!(String::from_utf8(empty).unwrap(), "(no data)\n");
    }

    #[test]
    fn renders_json_output_and_empty_result() {
        let mut output = Vec::new();
        write_monthly_invoice_json(
            &mut output,
            &[("2026-01".to_string(), 1800), ("2026-02".to_string(), 2700)],
        );
        assert_eq!(
            String::from_utf8(output).unwrap(),
            "{\"months\":[{\"month\":\"2026-01\",\"billable_seconds\":1800},{\"month\":\"2026-02\",\"billable_seconds\":2700}],\"total_billable_seconds\":4500}\n"
        );

        let mut empty = Vec::new();
        write_monthly_invoice_json(&mut empty, &[]);
        assert_eq!(
            String::from_utf8(empty).unwrap(),
            "{\"months\":[],\"total_billable_seconds\":0}\n"
        );
    }

    #[tokio::test]
    async fn normalizes_and_delegates_date_filters() {
        let mut api_client = MockApiClient::new();
        let (expected_since, expected_until) = crate::utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .unwrap();
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected_since && *until == expected_until)
            .returning(|_, _| Ok(Vec::new()));

        InvoiceMonthlyCommand::execute(
            api_client,
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
            false,
        )
        .await
        .unwrap();
    }
}
