use std::{
    collections::BTreeMap,
    io::{self, BufWriter, Write},
};

use chrono::{Datelike, NaiveDate};
use serde::Serialize;

use crate::{
    api::client::ApiClient,
    models::{ResultWithDefaultError, TimeEntry},
    utilities,
};

pub struct BillWeeklyCommand;

#[derive(Serialize)]
struct BillableWeek {
    week: String,
    billable_seconds: i64,
}

#[derive(Serialize)]
struct BillWeeklyOutput {
    weeks: Vec<BillableWeek>,
    total_billable_seconds: i64,
}

fn billable_seconds(entry: &TimeEntry) -> Option<i64> {
    // A running entry has a negative duration, which is not invoiceable yet.
    (entry.billable && entry.stop.is_some()).then_some(entry.duration)
}

fn week_start(entry: &TimeEntry) -> NaiveDate {
    let date = entry.start.date_naive();
    date - chrono::Duration::days(date.weekday().num_days_from_monday().into())
}

fn aggregate_by_week(entries: impl IntoIterator<Item = TimeEntry>) -> BTreeMap<NaiveDate, i64> {
    let mut weeks = BTreeMap::new();
    for entry in entries {
        if let Some(seconds) = billable_seconds(&entry) {
            *weeks.entry(week_start(&entry)).or_default() += seconds;
        }
    }
    weeks
}

fn output_lines(weeks: BTreeMap<NaiveDate, i64>) -> Vec<String> {
    if weeks.is_empty() {
        return vec!["(no data)".to_string()];
    }

    let total: i64 = weeks.values().sum();
    let mut lines = weeks
        .into_iter()
        .map(|(monday, seconds)| format!("{}  {seconds}s", monday.format("%Y-%m-%d")))
        .collect::<Vec<_>>();
    lines.push(format!("Total  {total}s"));
    lines
}

fn json_output(weeks: BTreeMap<NaiveDate, i64>) -> BillWeeklyOutput {
    let total_billable_seconds = weeks.values().sum();
    let weeks = weeks
        .into_iter()
        .map(|(monday, billable_seconds)| BillableWeek {
            week: monday.format("%Y-%m-%d").to_string(),
            billable_seconds,
        })
        .collect();

    BillWeeklyOutput {
        weeks,
        total_billable_seconds,
    }
}

impl BillWeeklyCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client
            .get_time_entries_filtered_minimal(since, until)
            .await?;
        let weeks = aggregate_by_week(entries);

        let stdout = io::stdout();
        let mut output = BufWriter::new(stdout.lock());
        if json {
            writeln!(
                output,
                "{}",
                serde_json::to_string(&json_output(weeks)).expect("failed to serialize bill data")
            )
            .expect("failed to print");
        } else {
            for line in output_lines(weeks) {
                writeln!(output, "{line}").expect("failed to print");
            }
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use chrono::{TimeZone, Utc};

    use super::*;

    fn entry(id: i64, start: &str, duration: i64, billable: bool, stopped: bool) -> TimeEntry {
        TimeEntry {
            id,
            description: String::new(),
            start: Utc.datetime_from_str(start, "%Y-%m-%dT%H:%M:%SZ").unwrap(),
            stop: stopped.then(|| Utc.datetime_from_str(start, "%Y-%m-%dT%H:%M:%SZ").unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project: None,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn groups_closed_billable_entries_by_utc_iso_week_oldest_first() {
        let entries = vec![
            entry(1, "2026-03-08T23:30:00Z", 60, true, true),
            entry(2, "2026-03-09T00:30:00Z", 120, true, true),
            entry(3, "2026-03-10T12:00:00Z", 30, false, true),
            entry(4, "2026-03-11T12:00:00Z", -1, true, false),
            entry(5, "2026-03-02T12:00:00Z", 180, true, true),
        ];

        assert_eq!(
            output_lines(aggregate_by_week(entries)),
            vec![
                "2026-03-02  240s".to_string(),
                "2026-03-09  120s".to_string(),
                "Total  360s".to_string(),
            ]
        );
    }

    #[test]
    fn prints_no_data_when_no_entry_is_invoiceable() {
        assert_eq!(
            output_lines(aggregate_by_week(vec![entry(
                1,
                "2026-03-02T12:00:00Z",
                -1,
                true,
                false
            )])),
            vec!["(no data)".to_string()]
        );
    }

    #[test]
    fn json_output_uses_snake_case_keys_and_includes_empty_results() {
        let output = json_output(aggregate_by_week(vec![
            entry(1, "2026-03-09T12:00:00Z", 120, true, true),
            entry(2, "2026-03-02T12:00:00Z", 180, true, true),
        ]));
        assert_eq!(
            serde_json::to_string(&output).unwrap(),
            "{\"weeks\":[{\"week\":\"2026-03-02\",\"billable_seconds\":180},{\"week\":\"2026-03-09\",\"billable_seconds\":120}],\"total_billable_seconds\":300}"
        );

        assert_eq!(
            serde_json::to_string(&json_output(BTreeMap::new())).unwrap(),
            "{\"weeks\":[],\"total_billable_seconds\":0}"
        );
    }
}
