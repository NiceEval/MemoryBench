use crate::api::client::ApiClient;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

const ROUNDING_INCREMENT_SECONDS: i64 = 15 * 60;
const MINIMUM_ENTRY_SECONDS: i64 = 30 * 60;
const NO_PROJECT: &str = "No Project";

pub struct InvoiceCommand;

#[derive(Debug, PartialEq, Eq)]
struct InvoiceProject {
    name: String,
    seconds: i64,
}

fn billed_seconds(duration: i64) -> i64 {
    let rounded_up = duration
        .max(0)
        .saturating_add(ROUNDING_INCREMENT_SECONDS - 1)
        / ROUNDING_INCREMENT_SECONDS
        * ROUNDING_INCREMENT_SECONDS;
    rounded_up.max(MINIMUM_ENTRY_SECONDS)
}

fn invoice_projects(entries: &[TimeEntry]) -> Vec<InvoiceProject> {
    let mut projects: HashMap<Option<i64>, InvoiceProject> = HashMap::new();

    for entry in entries
        .iter()
        .filter(|entry| entry.billable && entry.stop.is_some() && !entry.is_running())
    {
        let project_id = entry.project.as_ref().map(|project| project.id);
        let name = entry
            .project
            .as_ref()
            .map(|project| project.name.clone())
            .unwrap_or_else(|| NO_PROJECT.to_string());
        projects
            .entry(project_id)
            .and_modify(|project| project.seconds += billed_seconds(entry.duration))
            .or_insert(InvoiceProject {
                name,
                seconds: billed_seconds(entry.duration),
            });
    }

    let mut projects: Vec<_> = projects.into_values().collect();
    projects.sort_by(|left, right| {
        right
            .seconds
            .cmp(&left.seconds)
            .then_with(|| left.name.cmp(&right.name))
    });
    projects
}

fn write_invoice(mut output: impl Write, entries: &[TimeEntry]) {
    let projects = invoice_projects(entries);
    if projects.is_empty() {
        writeln!(output, "(no data)").expect("failed to print");
        return;
    }

    let total: i64 = projects.iter().map(|project| project.seconds).sum();
    for project in projects {
        writeln!(output, "{}s  {}", project.seconds, project.name).expect("failed to print");
    }
    writeln!(output, "{total}s  Total").expect("failed to print");
}

impl InvoiceCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let entries = if since.is_some() || until.is_some() {
            let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
            api_client.get_time_entries_filtered(since, until).await?
        } else {
            api_client.get_entities().await?.time_entries
        };

        let stdout = io::stdout();
        write_invoice(BufWriter::new(stdout), &entries);
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::models::Project;
    use chrono::{TimeZone, Utc};

    fn entry(
        duration: i64,
        billable: bool,
        running: bool,
        project: Option<(i64, &str)>,
    ) -> TimeEntry {
        let start = Utc.timestamp_opt(1_700_000_000, 0).single().unwrap();
        TimeEntry {
            id: duration,
            description: String::new(),
            start,
            stop: (!running).then_some(start + chrono::Duration::seconds(duration.max(0))),
            duration: if running {
                -start.timestamp()
            } else {
                duration
            },
            billable,
            workspace_id: 1,
            tags: vec![],
            project: project.map(|(id, name)| Project {
                id,
                name: name.to_string(),
                workspace_id: 1,
                client: None,
                is_private: false,
                active: true,
                at: start,
                created_at: start,
                color: "#000000".to_string(),
                billable: Some(true),
            }),
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn invoice_rounds_each_entry_and_applies_the_minimum() {
        let entries = vec![
            entry(1, true, false, Some((1, "Alpha"))),
            entry(901, true, false, Some((1, "Alpha"))),
            entry(1_801, true, false, Some((2, "Beta"))),
            entry(3_600, false, false, Some((3, "Ignored"))),
            entry(3_600, true, true, Some((4, "Running"))),
        ];

        assert_eq!(
            invoice_projects(&entries),
            vec![
                InvoiceProject {
                    name: "Alpha".to_string(),
                    seconds: 3_600
                },
                InvoiceProject {
                    name: "Beta".to_string(),
                    seconds: 2_700
                },
            ]
        );
    }

    #[test]
    fn invoice_sorts_ties_alphabetically_and_uses_no_project() {
        let entries = vec![
            entry(1_800, true, false, Some((1, "Zulu"))),
            entry(1_800, true, false, Some((2, "Alpha"))),
            entry(1_800, true, false, None),
        ];
        let mut output = Vec::new();
        write_invoice(&mut output, &entries);

        assert_eq!(
            String::from_utf8(output).unwrap(),
            "1800s  Alpha\n1800s  No Project\n1800s  Zulu\n5400s  Total\n"
        );
    }

    #[test]
    fn invoice_prints_no_data_when_no_completed_billable_entries_exist() {
        let entries = vec![
            entry(3_600, false, false, None),
            entry(3_600, true, true, None),
        ];
        let mut output = Vec::new();
        write_invoice(&mut output, &entries);

        assert_eq!(String::from_utf8(output).unwrap(), "(no data)\n");
    }
}
