ction::Update { json, .. }\n                | EntryAction::Delete { json, .. }\n                | EntryAction::Search { json, .. } => *json,\n                EntryAction::Bill { .. } | EntryAction::BulkEdit { .. } => false,\n            },\n            Command::Project { action } => match action {\n                ProjectAction::List { json, .. } => *json,\n                _ => false,\n            return Err(Box::new(error::ArgumentError::MissingArgument(\n                \"'bulk-edit' requires --json flag with JSON payload\".to_string(),\n            )));\n        }\n        _ => {}\n    }\n\n    let api_client = get_api_client(proxy.clone())?;\n\n    match action {\n        EntryAction::Current { json } => RunningTimeEntryCommand::execute(api_client, json).await,\n        EntryAction::List {\n            number,\n            json,\n            since,\n            until,\n        } => ListCommand::execute(api_client, number, json, since, until, None).await,\n        EntryAction::Bill { since, until } => BillCommand::execute(api_client, since, until).await,\n        EntryAction::Stop { json } => {\n            StopCommand::execute(&api_client, StopCommandOrigin::CommandLine, json).await?;\n            Ok(())\n        }\n        EntryAction::Start {\n            billable,\n            description,\n            project,\n            task,\n            tags,\n            start,\nuse crate::api::client::ApiClient;\nuse crate::constants;\nuse crate::models::{ResultWithDefaultError, TimeEntry};\nuse crate::utilities;\nuse std::collections::HashMap;\nuse std::io::{self, BufWriter, Write};\n\nconst BILLING_UNIT_SECONDS: i64 = 15 * 60;\n\npub struct BillCommand;\n\nfn rounded_billing_seconds(duration: i64) -> i64 {\n    (duration / BILLING_UNIT_SECONDS + i64::from(duration % BILLING_UNIT_SECONDS != 0))\n        * BILLING_UNIT_SECONDS\n}\n\nfn billable_totals(entries: impl IntoIterator<Item = TimeEntry>) -> Vec<(String, i64)> {\n    let mut totals = HashMap::new();\n\n    for