use crate::api::client::ApiClient;
use crate::constants;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use serde_json::json;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

const BILLING_UNIT_SECONDS: i64 = 15 * 60;

pub struct BillCommand;

fn rounded_billing_seconds(duration: i64) -> i64 {
    (duration / BILLING_UNIT_SECONDS + i64::from(duration % BILLING_UNIT_SECONDS != 0))
        * BILLING_UNIT_SECONDS
}

fn billable_totals(entries: impl IntoIterator<Item = TimeEntry>) -> Vec<(String, i64)> {
    let mut totals = HashMap::new();

    for entry in entries {
        if !entry.billable || entry.stop.is_none() || entry.duration <= 0 {
            continue;
        }

        let project = entry
            .project
            .map(|project| project.name)
            .unwrap_or_else(|| constants::NO_PROJECT.to_string());
        *totals.entry(project).or_insert(0) += rounded_billing_seconds(entry.duration);
    }

    let mut totals: Vec<_> = totals.into_iter().collect();
    totals.sort_by(|(left_name, left_total), (right_name, right_total)| {
        right_total
            .cmp(left_total)
            .then_with(|| left_name.cmp(right_name))
    });
    totals
}

fn format_bill_totals(totals: &[(String, i64)]) -> String {
    if totals.is_empty() {
        return "(no data)\n".to_string();
    }

    let total: i64 = totals.iter().map(|(_, seconds)| seconds).sum();
    let mut output = String::new();
    for (project, seconds) in totals {
        output.push_str(&format!("{seconds}s  {project}\n"));
    }
    output.push_str(&format!("{total}s  Total\n"));
    output
}

fn format_bill_totals_json(totals: &[(String, i64)]) -> String {
    let projects: Vec<_> = totals
        .iter()
        .map(|(project, billable_seconds)| {
            json!({
                "project": project,
                "billable_seconds": billable_seconds,
            })
        })
        .collect();
    let total_billable_seconds: i64 = totals.iter().map(|(_, seconds)| seconds).sum();
    serde_json::to_string(&json!({
        "projects": projects,
        "total_billable_seconds": total_billable_seconds,
    }))
    .expect("failed to serialize billing totals")
}

impl BillCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
        json: bool,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let totals = billable_totals(api_client.get_time_entries_filtered(since, until).await?);

        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout);
        if json {
            writeln!(handle, "{}", format_bill_totals_json(&totals)).expect("failed to print");
        } else {
            write!(handle, "{}", format_bill_totals(&totals)).expect("failed to print");
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::api::client::MockApiClient;
    use crate::models::{Project, TimeEntry};
    use chrono::{TimeZone, Utc};
    use tokio_test::assert_ok;

    fn entry(duration: i64, billable: bool, stopped: bool, project: Option<&str>) -> TimeEntry {
        let project = project.map(|name| Project {
            id: 1,
            name: name.to_string(),
            workspace_id: 1,
            client: None,
            is_private: false,
            active: true,
            at: Utc.timestamp_opt(0, 0).unwrap(),
            created_at: Utc.timestamp_opt(0, 0).unwrap(),
            color: "#000000".to_string(),
            billable: Some(true),
        });
        TimeEntry {
            id: 1,
            description: String::new(),
            start: Utc.timestamp_opt(0, 0).unwrap(),
            stop: stopped.then(|| Utc.timestamp_opt(duration, 0).unwrap()),
            duration,
            billable,
            workspace_id: 1,
            tags: vec![],
            project,
            task: None,
            created_with: None,
        }
    }

    #[test]
    fn bills_each_stopped_billable_entry_in_15_minute_units() {
        let totals = billable_totals(vec![
            entry(7 * 60, true, true, Some("Alpha")),
            entry(22 * 60, true, true, Some("Alpha")),
            entry(15 * 60, true, true, None),
            entry(60 * 60, false, true, Some("Ignored")),
            entry(-60, true, false, Some("Running")),
        ]);

        assert_eq!(
            totals,
            vec![
                ("Alpha".to_string(), 45 * 60),
                (constants::NO_PROJECT.to_string(), 15 * 60),
            ]
        );
    }

    #[test]
    fn orders_equal_totals_alphabetically() {
        let totals = billable_totals(vec![
            entry(1, true, true, Some("Zulu")),
            entry(1, true, true, Some("Alpha")),
            entry(16 * 60, true, true, Some("Longer")),
        ]);

        assert_eq!(
            totals,
            vec![
                ("Longer".to_string(), 30 * 60),
                ("Alpha".to_string(), 15 * 60),
                ("Zulu".to_string(), 15 * 60),
            ]
        );
    }

    #[test]
    fn formats_project_totals_and_empty_results() {
        assert_eq!(
            format_bill_totals(&[
                ("Alpha".to_string(), 2700),
                (constants::NO_PROJECT.to_string(), 900),
            ]),
            "2700s  Alpha\n900s  No Project\n3600s  Total\n"
        );
        assert_eq!(format_bill_totals(&[]), "(no data)\n");
    }

    #[test]
    fn formats_json_with_project_order_and_empty_results() {
        assert_eq!(
            format_bill_totals_json(&[
                ("Alpha".to_string(), 2700),
                (constants::NO_PROJECT.to_string(), 900),
            ]),
            "{\"projects\":[{\"project\":\"Alpha\",\"billable_seconds\":2700},{\"project\":\"No Project\",\"billable_seconds\":900}],\"total_billable_seconds\":3600}"
        );
        assert_eq!(
            format_bill_totals_json(&[]),
            "{\"projects\":[],\"total_billable_seconds\":0}"
        );
    }

    #[tokio::test]
    async fn normalizes_date_filters_before_fetching_entries() {
        let mut api_client = MockApiClient::new();
        let expected = utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .expect("date filters should normalize");
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected.0 && *until == expected.1)
            .returning(|_, _| Ok(vec![]));

        assert_ok!(
            BillCommand::execute(
                api_client,
                Some("2026-01-01".to_string()),
                Some("2026-01-31".to_string()),
                false,
            )
            .await
        );
    }
}
