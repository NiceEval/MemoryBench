use crate::api::client::ApiClient;
use crate::constants;
use crate::models::{ResultWithDefaultError, TimeEntry};
use crate::utilities;
use std::collections::HashMap;
use std::io::{self, BufWriter, Write};

pub struct EntryStatsCommand;

#[derive(Debug, PartialEq, Eq)]
struct ProjectDuration {
    name: String,
    seconds: i64,
}

fn summarize(entries: Vec<TimeEntry>) -> Vec<ProjectDuration> {
    let mut totals: HashMap<Option<i64>, ProjectDuration> = HashMap::new();

    for entry in entries
        .into_iter()
        .filter(|entry| !entry.duration.is_negative())
    {
        let (project_id, project_name) = entry
            .project
            .as_ref()
            .map(|project| (Some(project.id), project.name.clone()))
            .unwrap_or((None, constants::NO_PROJECT.to_string()));

        let total = totals.entry(project_id).or_insert(ProjectDuration {
            name: project_name,
            seconds: 0,
        });
        total.seconds += entry.duration;
    }

    let mut totals: Vec<_> = totals.into_values().collect();
    totals.sort_by(|left, right| {
        right
            .seconds
            .cmp(&left.seconds)
            .then_with(|| left.name.cmp(&right.name))
    });
    totals
}

fn render(entries: Vec<TimeEntry>) -> String {
    let totals = summarize(entries);
    let total_seconds: i64 = totals.iter().map(|project| project.seconds).sum();
    let mut output = String::new();

    for project in totals {
        output.push_str(&format!(
            "{}  {}\n",
            utilities::format_duration_compact(project.seconds),
            project.name
        ));
    }
    output.push_str(&format!(
        "{}  Total\n",
        utilities::format_duration_compact(total_seconds)
    ));
    output
}

impl EntryStatsCommand {
    pub async fn execute(
        api_client: impl ApiClient,
        since: Option<String>,
        until: Option<String>,
    ) -> ResultWithDefaultError<()> {
        let (since, until) = utilities::normalize_time_entry_list_filters(since, until)?;
        let entries = api_client.get_time_entries_filtered(since, until).await?;
        let stdout = io::stdout();
        let mut handle = BufWriter::new(stdout.lock());
        write!(handle, "{}", render(entries)).expect("failed to print");
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::{render, EntryStatsCommand};
    use crate::api::client::MockApiClient;
    use crate::models::{Project, TimeEntry};
    use chrono::{TimeZone, Utc};

    fn project(id: i64, name: &str) -> Project {
        let timestamp = Utc.timestamp_opt(0, 0).single().unwrap();
        Project {
            id,
            name: name.to_string(),
            workspace_id: 1,
            client: None,
            is_private: false,
            active: true,
            at: timestamp,
            created_at: timestamp,
            color: "#000000".to_string(),
            billable: None,
        }
    }

    fn entry(duration: i64, project: Option<Project>) -> TimeEntry {
        TimeEntry {
            duration,
            project,
            ..Default::default()
        }
    }

    #[test]
    fn stats_groups_sorts_and_skips_running_entries() {
        let output = render(vec![
            entry(3_600, Some(project(1, "Beta"))),
            entry(1_800, Some(project(1, "Beta"))),
            entry(5_400, Some(project(2, "Alpha"))),
            entry(2_700, None),
            entry(-1, Some(project(3, "Ignored"))),
        ]);

        assert_eq!(
            output,
            "1h 30m  Alpha\n1h 30m  Beta\n45m  No Project\n3h 45m  Total\n"
        );
    }

    #[test]
    fn stats_prints_a_zero_total_for_an_empty_window() {
        assert_eq!(render(Vec::new()), "0m  Total\n");
    }

    #[tokio::test]
    async fn stats_uses_the_standard_date_filter_normalization() {
        let mut api_client = MockApiClient::new();
        let (expected_since, expected_until) = crate::utilities::normalize_time_entry_list_filters(
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .expect("date filters should normalize");
        api_client
            .expect_get_time_entries_filtered()
            .withf(move |since, until| *since == expected_since && *until == expected_until)
            .returning(|_, _| Ok(Vec::new()));

        let result = EntryStatsCommand::execute(
            api_client,
            Some("2026-01-01".to_string()),
            Some("2026-01-31".to_string()),
        )
        .await;

        assert!(result.is_ok());
    }
}
