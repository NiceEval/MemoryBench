/**
 * Shared document event delegation.
 *
 * Instead of N tooltips each calling document.addEventListener(type, handler),
 * we maintain one document listener per event type and propagation phase.
 * When the event fires, we iterate through all registered handlers for that type.
 *
 * This reduces document-level listeners from O(N × eventTypes) to O(eventTypes).
 */

type Handler = (event: Event) => void

type EventHandlers = {
  capture: Set<Handler>
  bubble: Set<Handler>
}

const handlersByType = new Map<string, EventHandlers>()

function dispatch(event: Event, phase: keyof EventHandlers): void {
  const handlers = handlersByType.get(event.type)?.[phase]
  if (handlers) {
    // Safe to iterate directly — mutations (add/remove) only happen in
    // setup/cleanup, not during dispatch. Set iteration is stable for
    // entries that existed when iteration began.
    handlers.forEach((handler) => {
      handler(event)
    })
  }
}

function dispatchCapture(event: Event): void {
  dispatch(event, 'capture')
}

function dispatchBubble(event: Event): void {
  dispatch(event, 'bubble')
}

/**
 * Register a handler for a document-level event type.
 * Returns an unsubscribe function.
 */
export function addDelegatedEventListener(
  eventType: string,
  handler: Handler,
  useCapture = false,
): () => void {
  let handlers = handlersByType.get(eventType)
  if (!handlers) {
    handlers = { capture: new Set(), bubble: new Set() }
    handlersByType.set(eventType, handlers)
  }

  const phase = useCapture ? 'capture' : 'bubble'
  const set = handlers[phase]
  if (set.size === 0) {
    document.addEventListener(eventType, useCapture ? dispatchCapture : dispatchBubble, useCapture)
  }
  set.add(handler)

  return () => {
    set.delete(handler)
    if (set.size === 0) {
      document.removeEventListener(
        eventType,
        useCapture ? dispatchCapture : dispatchBubble,
        useCapture,
      )
    }
    if (handlers.capture.size === 0 && handlers.bubble.size === 0) {
      handlersByType.delete(eventType)
    }
  }
}

/**
 * Reset for testing purposes.
 */
export function resetEventDelegation(): void {
  handlersByType.forEach((handlers, eventType) => {
    if (handlers.capture.size > 0) {
      document.removeEventListener(eventType, dispatchCapture, true)
    }
    if (handlers.bubble.size > 0) {
      document.removeEventListener(eventType, dispatchBubble)
    }
  })
  handlersByType.clear()
}
