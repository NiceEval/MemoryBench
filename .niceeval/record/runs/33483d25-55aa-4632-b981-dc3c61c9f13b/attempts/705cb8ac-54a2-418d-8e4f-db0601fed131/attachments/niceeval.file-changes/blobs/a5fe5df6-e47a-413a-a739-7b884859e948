import * as React from "react";
import { act, render, screen } from "@testing-library/react";

import { lightbox, expectLightboxToBeOpen } from "../test-utils.js";
import { ZoomRef } from "../../../src/index.js";
import { Zoom as ZoomPlugin } from "../../../src/plugins/index.js";

describe("Zoom", () => {
  it("renders without crashing", async () => {
    render(
      lightbox({
        slides: Array.from({ length: 3 }).map((_, i) => ({
          src: `image${i + 1}`,
          width: 3000,
          height: 2000,
        })),
        plugins: [ZoomPlugin],
      }),
    );

    act(() => {
      screen.getByLabelText("Zoom in").click();
    });

    act(() => {
      screen.getByLabelText("Zoom out").click();
    });

    expectLightboxToBeOpen();
  });

  it("supports zooming custom slide types", () => {
    const zoomRef = React.createRef<ZoomRef>();

    render(
      lightbox({
        slides: [{ type: "custom" }] as never,
        plugins: [ZoomPlugin],
        zoom: { ref: zoomRef, supports: ["custom"] },
        render: {
          slide: ({ slide }) =>
            slide.type === "custom" ? React.createElement("div", { "data-testid": "custom-slide" }) : null,
        },
      }),
    );

    expect(document.querySelector(".yarl__slide_current .yarl__slide_wrapper")).toContainElement(
      screen.getAllByTestId("custom-slide")[1],
    );
    expect(zoomRef.current).toMatchObject({ disabled: false, maxZoom: 8 });

    act(() => {
      screen.getByLabelText("Zoom in").click();
    });

    expect(zoomRef.current?.zoom).toBe(2);
  });

  it("uses the configured maximum zoom for custom slide types", () => {
    const zoomRef = React.createRef<ZoomRef>();

    render(
      lightbox({
        slides: [{ type: "custom" }] as never,
        plugins: [ZoomPlugin],
        zoom: { ref: zoomRef, supports: ["custom"], maxZoom: () => 3 },
        render: { slide: ({ slide }) => (slide.type === "custom" ? React.createElement("div") : null) },
      }),
    );

    expect(zoomRef.current).toMatchObject({ disabled: false, maxZoom: 3 });
  });

  it("does not wrap unsupported custom slide types", () => {
    const zoomRef = React.createRef<ZoomRef>();

    render(
      lightbox({
        slides: [{ type: "custom" }] as never,
        plugins: [ZoomPlugin],
        zoom: { ref: zoomRef },
        render: { slide: ({ slide }) => (slide.type === "custom" ? React.createElement("div") : null) },
      }),
    );

    expect(document.querySelector(".yarl__slide_current .yarl__slide_wrapper")).toBeNull();
    expect(zoomRef.current?.disabled).toBe(true);
  });
});
