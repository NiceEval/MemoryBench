# 复制成 .env 并填值(.env 已被 gitignore)。
# 所有 agent 共用一个 OpenAI 兼容代理;模型由实验 ctx.model 给(compare/ 里钉的是 gpt-5.4)。

# codex:写进 ~/.codex/config.toml 的自定义 model_provider(wire_api=responses → 打到 {base}/responses)
CODEX_API_KEY=sk-...
CODEX_BASE_URL=https://your-proxy.example/v1

# bub:同一个代理
BUB_API_KEY=sk-...
BUB_API_BASE=https://your-proxy.example/v1

# 所有实验使用本机 Docker provider；无需 provider API key。
# 运行前确认 Docker daemon 已启动，并先构建需要的专属镜像：
# pnpm docker:mempal codex
# pnpm docker:mempal claude
# pnpm docker:remem
# pnpm docker:obelisk

# mem0:Mem0 Platform(https://app.mem0.ai)。key 以 m0- 开头。
# 无账号时可 `npx @mem0/cli init --agent --agent-caller memorybench --json` 签发 Agent Mode key。
MEM0_API_KEY=m0-...
# 可选:记忆隔离作用域(默认 memorybench 或 Agent Mode 的 default_user_id)
# MEM0_USER_ID=memorybench

# nowledge:固定远程 Nowledge Mem 实例(见 experiments/shared/nowledge.ts)
NMEM_API_URL=https://your-nowledge-endpoint.example
NMEM_API_KEY=nmem_...
# 可选的公开批次标签与服务端版本；不设置时使用当前直连实例的默认条件。
# NOWLEDGE_COHORT=configured-local-20260802
# NOWLEDGE_SERVER_VERSION=0.10.48
