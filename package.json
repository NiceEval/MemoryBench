{
  "name": "memorybench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "用 niceeval 写的「coding agent 记忆能力」评测套件,跨 claude-code / codex / bub",
  "scripts": {
    "report:dev": "astro dev --config website/astro.config.mjs",
    "report:build": "astro build --config website/astro.config.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "niceeval exp dev memory/agent-029-use-cache-directive"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "astro": "^7.2.9",
    "dockerode": "^5.0.1",
    "effect": "4.0.0-rc.112",
    "niceeval": "0.0.0-development",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.10.0"
}
